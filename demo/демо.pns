// демо.pns — минимальное relying-party (OAuth2/OIDC-клиент) приложение,
// показывающее полный Authorization Code + PKCE flow против живого
// дозорного: "Войти" -> /authorize (дозорный) -> форма логина/согласия
// (дозорный) -> /callback (сюда) -> обмен code на токены -> запрос
// /userinfo -> страница с разобранными claims id_token и ответом
// userinfo. Ничего не имитирует — реальный сетевой round-trip к
// реальному запущенному дозорному, тот же http-клиент, что использует
// тест_дозорный.pns.
//
// code_verifier передаётся через OAuth `state` (дозорный возвращает его
// НЕТРОНУТЫМ через весь редирект-цикл, см. oauth.pns) — это НАМЕРЕННОЕ
// упрощение для локальной демки без сессий/cookie (panos не имеет
// top-level мутируемого состояния, а полноценная серверная сессия —
// лишняя сложность для примера на 100 строк). Не паттерн для боевого
// relying-party: там verifier обычно живёт в server-side сессии или
// httpOnly cookie, не в state, который виден в истории браузера.

импорт "сеть/http" как http
импорт "кодирование/json" как json
импорт криптография
импорт строки
импорт ввод_вывод

// --- Настройка: заполнить ПОСЛЕ регистрации клиента в admin SPA дозорного ---
//
// 1. panos старт.pns   (в каталоге дозорный/, отдельный процесс/порт)
// 2. открыть ДОЗОРНЫЙ_URL + "/admin", войти паролем из лога bootstrap
// 3. вкладка "Клиенты" -> Добавить: имя любое, redirect_uri = СВОЙ_URL +
//    "/callback", scope "openid profile email", публичный "нет"
// 4. скопировать client_id/client_secret из ответа СЮДА
конст ДОЗОРНЫЙ_URL = "http://127.0.0.1:8080"
конст ПОРТ = 9090
конст СВОЙ_URL = "http://127.0.0.1:9090"
конст CLIENT_ID = "ЗАПОЛНИТЬ_ПОСЛЕ_РЕГИСТРАЦИИ"
конст CLIENT_SECRET = "ЗАПОЛНИТЬ_ПОСЛЕ_РЕГИСТРАЦИИ"

функ страница(тело: Строка) -> Строка
	"<!doctype html><html><head><meta charset=\"utf-8\" /><title>демо relying-party</title>" +
	"<style>body{font-family:-apple-system,sans-serif;max-width:40rem;margin:3rem auto;padding:0 1rem;color:#0f172a}" +
	"a.кнопка,button{display:inline-block;background:#6366f1;color:white;padding:0.6rem 1rem;border-radius:0.5rem;text-decoration:none;font-weight:600;border:none;cursor:pointer}" +
	"pre{background:#f8fafc;border:1px solid #e2e8f0;border-radius:0.6rem;padding:1rem;overflow:auto;font-size:0.85rem}" +
	"h1{font-size:1.3rem} .ошибка{color:#ef4444}</style></head><body>" + тело + "</body></html>"
конец

экспорт функ обработать_главную(зм: http.ЗапросМаршрута) -> http.ОтветСервера
	http.ответ(200, "text/html", страница(
		"<h1>Демо relying-party для дозорного</h1>" +
		"<p>Обычное клиентское приложение, использующее дозорный как OAuth2/OIDC identity provider.</p>" +
		"<p><a class=\"кнопка\" href=\"/login\">Войти через дозорный</a></p>"
	))
конец

экспорт функ обработать_login(зм: http.ЗапросМаршрута) -> http.ОтветСервера
	пер code_verifier = криптография.случайные_байты_base64url(32)
	пер code_challenge = криптография.sha256_base64url(code_verifier)

	пер параметры: Соответствие(Строка, Строка) = соответствие()
	параметры["response_type"] = "code"
	параметры["client_id"] = CLIENT_ID
	параметры["redirect_uri"] = СВОЙ_URL + "/callback"
	параметры["scope"] = "openid profile email"
	параметры["state"] = code_verifier
	параметры["code_challenge"] = code_challenge
	параметры["code_challenge_method"] = "S256"

	http.ответ_редирект(ДОЗОРНЫЙ_URL + "/authorize" + http.построить_query(параметры))
конец

/// Декодирует СРЕДНИЙ сегмент JWT (payload) без проверки подписи — для
/// демо-отображения claims. Подпись УЖЕ проверена дозорным на этапе
/// выдачи id_token; relying-party в общем случае обязан перепроверить
/// её сам (HS256 по client_secret либо ES256 по JWKS для публичных
/// клиентов, см. std/кодирование/jwt.pns) перед тем, как ДОВЕРЯТЬ
/// claims — здесь опущено ради краткости демки, не потому что не нужно.
функ декодировать_claims(токен: Строка) -> Строка
	пер части = строки.разбить(токен, ".")
	если части.длина() <> 3 тогда
		возврат "не удалось разобрать id_token"
	конец
	пер декод = криптография.base64url_декодировать(части.получить(1, ""))
	если декод.ошибка() тогда
		возврат "не удалось декодировать payload id_token"
	конец
	декод.значение()
конец

экспорт функ обработать_callback(зм: http.ЗапросМаршрута) -> http.ОтветСервера
	пер код_ошибки = зм.query.получить("error", "")
	если длина(код_ошибки) > 0 тогда
		возврат http.ответ(400, "text/html", страница("<h1 class=\"ошибка\">Ошибка авторизации</h1><p>" + код_ошибки + "</p><p><a href=\"/\">На главную</a></p>"))
	конец

	пер code = зм.query.получить("code", "")
	пер code_verifier = зм.query.получить("state", "")
	если длина(code) == 0 или длина(code_verifier) == 0 тогда
		возврат http.ответ(400, "text/html", страница("<h1 class=\"ошибка\">Нет code/state в callback</h1>"))
	конец

	пер поля_токена: Соответствие(Строка, Строка) = соответствие()
	поля_токена["grant_type"] = "authorization_code"
	поля_токена["code"] = code
	поля_токена["redirect_uri"] = СВОЙ_URL + "/callback"
	поля_токена["client_id"] = CLIENT_ID
	поля_токена["client_secret"] = CLIENT_SECRET
	поля_токена["code_verifier"] = code_verifier
	пер тело_запроса = http.построить_query(поля_токена)
	пер token_рез = http.отправить_пост(ДОЗОРНЫЙ_URL + "/token", строки.срез(тело_запроса, 1, длина(тело_запроса)))
	если token_рез.ошибка() тогда
		возврат http.ответ(502, "text/html", страница("<h1 class=\"ошибка\">/token недоступен</h1><p>" + token_рез.причина().сообщение + "</p>"))
	конец
	пер token_ответ = token_рез.значение()
	если token_ответ.статус <> 200 тогда
		возврат http.ответ(400, "text/html", страница("<h1 class=\"ошибка\">/token вернул " + строки.из_числа(token_ответ.статус) + "</h1><pre>" + token_ответ.тело + "</pre>"))
	конец

	пер тело_json = json.разобрать(token_ответ.тело)
	если тело_json.ошибка() тогда
		возврат http.ответ(500, "text/html", страница("<h1 class=\"ошибка\">некорректный JSON от /token</h1>"))
	конец
	пер значение = тело_json.значение()
	пер access_token = значение.поле("access_token").получить(json.Значение.Ноль).как_строку().получить("")
	пер id_token = значение.поле("id_token").получить(json.Значение.Ноль).как_строку().получить("")
	пер refresh_token = значение.поле("refresh_token").получить(json.Значение.Ноль).как_строку().получить("")

	пер заголовки: Соответствие(Строка, Строка) = соответствие()
	заголовки["Authorization"] = "Bearer " + access_token
	пер userinfo_текст = "(запрос /userinfo не удался)"
	пер userinfo_рез = http.получить_с_заголовками(ДОЗОРНЫЙ_URL + "/userinfo", заголовки)
	если не userinfo_рез.ошибка() тогда
		userinfo_текст = userinfo_рез.значение().тело
	конец

	http.ответ(200, "text/html", страница(
		"<h1>Вход выполнен</h1>" +
		"<p>Токены получены от дозорного через реальный Authorization Code + PKCE round-trip.</p>" +
		"<p>claims id_token:</p><pre>" + декодировать_claims(id_token) + "</pre>" +
		"<p>ответ /userinfo:</p><pre>" + userinfo_текст + "</pre>" +
		"<p>access_token (усечён): " + строки.срез(access_token, 0, если длина(access_token) < 24 тогда длина(access_token) иначе 24 конец) + "...</p>" +
		"<p>refresh_token получен: " + если длина(refresh_token) > 0 тогда "да" иначе "нет" конец + "</p>" +
		"<p><a href=\"/\">На главную</a></p>"
	))
конец

функ старт() -> Результат(Число, Ошибка)
	если CLIENT_ID == "ЗАПОЛНИТЬ_ПОСЛЕ_РЕГИСТРАЦИИ" тогда
		ввод_вывод.строка("=== ВНИМАНИЕ: CLIENT_ID/CLIENT_SECRET не заполнены в demo/демо.pns ===")
		ввод_вывод.строка("Зарегистрируйте клиента в " + ДОЗОРНЫЙ_URL + "/admin (redirect_uri = " + СВОЙ_URL + "/callback), затем впишите client_id/client_secret в константы вверху файла.")
	конец

	пер маршрутизатор = http.маршрутизатор()
	маршрутизатор.получить("/", обработать_главную)
	маршрутизатор.получить("/login", обработать_login)
	маршрутизатор.получить("/callback", обработать_callback)

	ввод_вывод.строка("демо relying-party слушает " + СВОЙ_URL)
	http.обслуживать(ПОРТ, маршрутизатор.как_обработчик(), 1.0)
конец
