// main.pns — admin SPA для дозорного, TEA-стиль поверх марьяшка
// (Msg/update/dispatch, vdom-diff) вместо ручных DOM.*-вызовов.
// AOT-компилируется в WASM (тот же browser-тулчейн, что и раньше).
//
// Состояние между обработчиками кликов — марьяшка's состояние.*
// (см. panosiki/марьяшка/марьяшка.pns) — WASM не переживает отдельный
// вызов, модель сериализуется целиком в JSON (std/кодирование/json.pns)
// вместо самодельного "|"-формата, который был здесь раньше.

импорт DOM
импорт строки
импорт коллекции как кол
импорт "сеть" как сеть
импорт "кодирование/json" как json
импорт "../модули/марьяшка/узел.pns" как узел
импорт "../модули/марьяшка/марьяшка.pns"

// --- Модель ---
//
// Каждая структура ≤3 полей — предел AOT WASM struct-конструктора
// (см. panosiki/марьяшка/узел.pns про то же ограничение) — вложенные
// под-типы там, где полей больше.

тип Сессия = структура
	токен:      Строка
	раздел:     Строка
	editing_id: Строка
конец

тип ПользовательИнфо = структура
	email:   Строка
	активен: Булево
конец

тип Пользователь = структура
	ид:     Строка
	логин:  Строка
	инфо:   ПользовательИнфо
конец

реализация json.ИзJSON для Пользователь
	функ заполнить_из_json(это: Пользователь, значение: json.Значение) -> Опция(Ошибка)
		это.ид = строки.из_числа(значение.поле("ид").получить(json.Значение.Ноль).как_число().получить(0.0))
		это.логин = значение.поле("логин").получить(json.Значение.Ноль).как_строку().получить("")
		это.инфо.email = значение.поле("email").получить(json.Значение.Ноль).как_строку().получить("")
		это.инфо.активен = значение.поле("активен").получить(json.Значение.Ноль).как_булево().получить(ложь)
		Опция.Нет()
	конец
конец

реализация json.ВJSON для Пользователь
	функ в_json(это: Пользователь) -> json.Значение
		json.объект(массив(
			("ид", json.Значение.Строка(это.ид)),
			("логин", json.Значение.Строка(это.логин)),
			("email", json.Значение.Строка(это.инфо.email)),
			("активен", json.Значение.Булево(это.инфо.активен))
		))
	конец
конец

тип Группа = структура
	ид:  Строка
	имя: Строка
конец

реализация json.ИзJSON для Группа
	функ заполнить_из_json(это: Группа, значение: json.Значение) -> Опция(Ошибка)
		это.ид = строки.из_числа(значение.поле("ид").получить(json.Значение.Ноль).как_число().получить(0.0))
		это.имя = значение.поле("имя").получить(json.Значение.Ноль).как_строку().получить("")
		Опция.Нет()
	конец
конец

реализация json.ВJSON для Группа
	функ в_json(это: Группа) -> json.Значение
		json.объект(массив(
			("ид", json.Значение.Строка(это.ид)),
			("имя", json.Значение.Строка(это.имя))
		))
	конец
конец

// redirect_uris/scopes НЕ парсятся (как и в прежней ручной версии) —
// список клиентов их не показывает, а форма редактирования всё равно
// требует ввести их заново целиком (PUT заменяет оба поля разом).
тип Клиент = структура
	client_id:  Строка
	имя:        Строка
	публичный:  Булево
конец

реализация json.ИзJSON для Клиент
	функ заполнить_из_json(это: Клиент, значение: json.Значение) -> Опция(Ошибка)
		это.client_id = значение.поле("client_id").получить(json.Значение.Ноль).как_строку().получить("")
		это.имя = значение.поле("имя").получить(json.Значение.Ноль).как_строку().получить("")
		это.публичный = значение.поле("публичный").получить(json.Значение.Ноль).как_булево().получить(ложь)
		Опция.Нет()
	конец
конец

реализация json.ВJSON для Клиент
	функ в_json(это: Клиент) -> json.Значение
		json.объект(массив(
			("client_id", json.Значение.Строка(это.client_id)),
			("имя", json.Значение.Строка(это.имя)),
			("публичный", json.Значение.Булево(это.публичный))
		))
	конец
конец

тип Стадия = структура
	вид:      Строка
	включена: Булево
конец

реализация json.ИзJSON для Стадия
	функ заполнить_из_json(это: Стадия, значение: json.Значение) -> Опция(Ошибка)
		это.вид = значение.поле("вид").получить(json.Значение.Ноль).как_строку().получить("")
		это.включена = значение.поле("включена").получить(json.Значение.Ноль).как_булево().получить(ложь)
		Опция.Нет()
	конец
конец

реализация json.ВJSON для Стадия
	функ в_json(это: Стадия) -> json.Значение
		json.объект(массив(
			("вид", json.Значение.Строка(это.вид)),
			("включена", json.Значение.Булево(это.включена))
		))
	конец
конец

тип КлиентыИСтадии = структура
	клиенты: Массив(Клиент)
	стадии:  Массив(Стадия)
конец

тип Данные = структура
	пользователи: Массив(Пользователь)
	группы:       Массив(Группа)
	кс:           КлиентыИСтадии
конец

тип Сообщения = структура
	ошибка_логина: Строка
	новый_секрет:  Строка
конец

тип Модель = структура
	сессия:    Сессия
	данные:    Данные
	сообщения: Сообщения
конец

функ новая_модель() -> Модель
	Модель(Сессия("", "", ""), Данные(массив(), массив(), КлиентыИСтадии(массив(), массив())), Сообщения("", ""))
конец

реализация json.ВJSON для Модель
	функ в_json(это: Модель) -> json.Значение
		пер польз_json: Массив(json.Значение) = массив()
		для п в это.данные.пользователи цикл
			польз_json.добавить(п.в_json())
		конец
		пер групп_json: Массив(json.Значение) = массив()
		для г в это.данные.группы цикл
			групп_json.добавить(г.в_json())
		конец
		пер клиент_json: Массив(json.Значение) = массив()
		для к в это.данные.кс.клиенты цикл
			клиент_json.добавить(к.в_json())
		конец
		пер стадия_json: Массив(json.Значение) = массив()
		для с в это.данные.кс.стадии цикл
			стадия_json.добавить(с.в_json())
		конец
		json.объект(массив(
			("токен", json.Значение.Строка(это.сессия.токен)),
			("раздел", json.Значение.Строка(это.сессия.раздел)),
			("editing_id", json.Значение.Строка(это.сессия.editing_id)),
			("пользователи", json.список(польз_json)),
			("группы", json.список(групп_json)),
			("клиенты", json.список(клиент_json)),
			("стадии", json.список(стадия_json)),
			("ошибка_логина", json.Значение.Строка(это.сообщения.ошибка_логина)),
			("новый_секрет", json.Значение.Строка(это.сообщения.новый_секрет))
		))
	конец
конец

функ разобрать_список_пользователей(значение: json.Значение) -> Массив(Пользователь)
	пер результат: Массив(Пользователь) = массив()
	выбор значение
		json.Значение.Список(элементы) тогда
			для эл в элементы цикл
				пер п = Пользователь("", "", ПользовательИнфо("", ложь))
				п.заполнить_из_json(эл)
				результат.добавить(п)
			конец
		конец
		_ тогда конец
	конец
	результат
конец

функ разобрать_список_групп(значение: json.Значение) -> Массив(Группа)
	пер результат: Массив(Группа) = массив()
	выбор значение
		json.Значение.Список(элементы) тогда
			для эл в элементы цикл
				пер г = Группа("", "")
				г.заполнить_из_json(эл)
				результат.добавить(г)
			конец
		конец
		_ тогда конец
	конец
	результат
конец

функ разобрать_список_клиентов(значение: json.Значение) -> Массив(Клиент)
	пер результат: Массив(Клиент) = массив()
	выбор значение
		json.Значение.Список(элементы) тогда
			для эл в элементы цикл
				пер к = Клиент("", "", ложь)
				к.заполнить_из_json(эл)
				результат.добавить(к)
			конец
		конец
		_ тогда конец
	конец
	результат
конец

функ разобрать_список_стадий(значение: json.Значение) -> Массив(Стадия)
	пер результат: Массив(Стадия) = массив()
	выбор значение
		json.Значение.Список(элементы) тогда
			для эл в элементы цикл
				пер с = Стадия("", ложь)
				с.заполнить_из_json(эл)
				результат.добавить(с)
			конец
		конец
		_ тогда конец
	конец
	результат
конец

реализация json.ИзJSON для Модель
	функ заполнить_из_json(это: Модель, значение: json.Значение) -> Опция(Ошибка)
		это.сессия.токен = значение.поле("токен").получить(json.Значение.Ноль).как_строку().получить("")
		это.сессия.раздел = значение.поле("раздел").получить(json.Значение.Ноль).как_строку().получить("")
		это.сессия.editing_id = значение.поле("editing_id").получить(json.Значение.Ноль).как_строку().получить("")
		это.данные.пользователи = разобрать_список_пользователей(значение.поле("пользователи").получить(json.Значение.Ноль))
		это.данные.группы = разобрать_список_групп(значение.поле("группы").получить(json.Значение.Ноль))
		это.данные.кс.клиенты = разобрать_список_клиентов(значение.поле("клиенты").получить(json.Значение.Ноль))
		это.данные.кс.стадии = разобрать_список_стадий(значение.поле("стадии").получить(json.Значение.Ноль))
		это.сообщения.ошибка_логина = значение.поле("ошибка_логина").получить(json.Значение.Ноль).как_строку().получить("")
		это.сообщения.новый_секрет = значение.поле("новый_секрет").получить(json.Значение.Ноль).как_строку().получить("")
		Опция.Нет()
	конец
конец

функ разобрать_модель(текст: Строка) -> Модель
	пер м = новая_модель()
	если длина(текст) == 0 тогда
		возврат м
	конец
	пер рез = json.разобрать(текст)
	если рез.ошибка() тогда
		возврат м
	конец
	м.заполнить_из_json(рез.получить(json.Значение.Ноль))
	м
конец

функ сериализовать_модель(м: Модель) -> Строка
	json.сериализовать_из(м)
конец

// --- HTTP-помощники (JSON-тело, Authorization при наличии токена) ---

функ http_get(путь: Строка, токен: Строка) -> Опция(Строка)
	сеть.http_запрос_sync_с_заголовками("GET", путь, "", "Authorization: Bearer " + токен)
конец

функ http_post(путь: Строка, тело: Строка, токен: Строка) -> Опция(Строка)
	сеть.http_запрос_sync_с_заголовками("POST", путь, тело, "Authorization: Bearer " + токен)
конец

функ http_put(путь: Строка, тело: Строка, токен: Строка) -> Опция(Строка)
	сеть.http_запрос_sync_с_заголовками("PUT", путь, тело, "Authorization: Bearer " + токен)
конец

функ http_delete(путь: Строка, токен: Строка) -> Опция(Строка)
	сеть.http_запрос_sync_с_заголовками("DELETE", путь, "", "Authorization: Bearer " + токен)
конец

// --- Загрузка списков (побочный эффект внутри update — марьяшка
// намеренно не имеет Msg/Cmd-системы, HTTP делается напрямую, как и в
// прежней ручной версии) ---

функ загрузить_пользователей(м: Модель) -> Пусто
	пер тело = http_get("/api/пользователи", м.сессия.токен).получить("[]")
	м.данные.пользователи = разобрать_список_пользователей(json.разобрать(тело).получить(json.Значение.Ноль))
конец

функ загрузить_группы(м: Модель) -> Пусто
	пер тело = http_get("/api/группы", м.сессия.токен).получить("[]")
	м.данные.группы = разобрать_список_групп(json.разобрать(тело).получить(json.Значение.Ноль))
конец

функ загрузить_клиентов(м: Модель) -> Пусто
	пер тело = http_get("/api/клиенты", м.сессия.токен).получить("[]")
	м.данные.кс.клиенты = разобрать_список_клиентов(json.разобрать(тело).получить(json.Значение.Ноль))
конец

функ загрузить_стадии(м: Модель) -> Пусто
	пер тело = http_get("/api/стадии", м.сессия.токен).получить("[]")
	м.данные.кс.стадии = разобрать_список_стадий(json.разобрать(тело).получить(json.Значение.Ноль))
конец

функ загрузить_раздел(м: Модель) -> Пусто
	если м.сессия.раздел == "пользователи" тогда
		загрузить_пользователей(м)
	конец
	если м.сессия.раздел == "группы" тогда
		загрузить_группы(м)
	конец
	если м.сессия.раздел == "клиенты" тогда
		загрузить_клиентов(м)
	конец
	если м.сессия.раздел == "стадии" тогда
		загрузить_стадии(м)
	конец
конец

// --- Msg / update ---

тип Сообщение = перечисление
	ВвестиЛогин(Строка, Строка)
	ПереключитьРаздел(Строка)
	Выход
	ДобавитьПользователя(Строка, Строка, Строка)
	УдалитьПользователя(Строка)
	НачатьРедПользователя(Строка)
	СохранитьПользователя(Строка, Строка)
	ДобавитьГруппу(Строка)
	УдалитьГруппу(Строка)
	ДобавитьКлиента(НовыйКлиент)
	УдалитьКлиента(Строка)
	НачатьРедКлиента(Строка)
	СохранитьКлиента(Строка, Строка, Строка)
	ПереключитьСтадию(Строка, Булево)
конец

тип НовыйКлиент = структура
	имя:          Строка
	redirect_uri: Строка
	scope:        Строка
конец

функ обновить(сообщение: Сообщение, м: Модель) -> Модель
	выбор сообщение
		ВвестиЛогин(логин, пароль) тогда
			пер тело = json.сериализовать(json.объект(массив(("логин", json.Значение.Строка(логин)), ("пароль", json.Значение.Строка(пароль)))))
			пер рез = сеть.http_запрос_sync("POST", "/api/вход", тело)
			выбор рез
				Есть(тело_ответа) тогда
					пер токен = json.разобрать(тело_ответа).получить(json.Значение.Ноль).поле("токен").получить(json.Значение.Ноль).как_строку().получить("")
					если длина(токен) > 0 тогда
						м.сессия = Сессия(токен, "пользователи", "")
						м.сообщения.ошибка_логина = ""
						загрузить_раздел(м)
					иначе
						м.сообщения.ошибка_логина = "неверный логин или пароль"
					конец
				конец
				Нет тогда
					м.сообщения.ошибка_логина = "не удалось связаться с сервером"
				конец
			конец
		конец
		ПереключитьРаздел(раздел) тогда
			м.сессия = Сессия(м.сессия.токен, раздел, "")
			загрузить_раздел(м)
		конец
		Выход тогда
			м.сессия = Сессия("", "", "")
		конец
		ДобавитьПользователя(логин, пароль, email) тогда
			если длина(логин) > 0 и длина(пароль) > 0 тогда
				пер тело = json.сериализовать(json.объект(массив(("логин", json.Значение.Строка(логин)), ("пароль", json.Значение.Строка(пароль)), ("email", json.Значение.Строка(email)))))
				http_post("/api/пользователи", тело, м.сессия.токен)
				загрузить_пользователей(м)
			конец
		конец
		УдалитьПользователя(ид) тогда
			http_delete("/api/пользователи/" + ид, м.сессия.токен)
			загрузить_пользователей(м)
		конец
		НачатьРедПользователя(ид) тогда
			м.сессия.editing_id = ид
		конец
		СохранитьПользователя(email, активен_текст) тогда
			если длина(м.сессия.editing_id) > 0 тогда
				пер активен = активен_текст == "да" или активен_текст == "yes" или активен_текст == "true"
				пер тело = json.сериализовать(json.объект(массив(("email", json.Значение.Строка(email)), ("активен", json.Значение.Булево(активен)))))
				http_put("/api/пользователи/" + м.сессия.editing_id, тело, м.сессия.токен)
				м.сессия.editing_id = ""
				загрузить_пользователей(м)
			конец
		конец
		ДобавитьГруппу(имя) тогда
			если длина(имя) > 0 тогда
				пер тело = json.сериализовать(json.объект(массив(("имя", json.Значение.Строка(имя)))))
				http_post("/api/группы", тело, м.сессия.токен)
				загрузить_группы(м)
			конец
		конец
		УдалитьГруппу(ид) тогда
			http_delete("/api/группы/" + ид, м.сессия.токен)
			загрузить_группы(м)
		конец
		ДобавитьКлиента(нк) тогда
			если длина(нк.имя) > 0 и длина(нк.redirect_uri) > 0 тогда
				пер тело = json.сериализовать(json.объект(массив(
					("имя", json.Значение.Строка(нк.имя)),
					("redirect_uri", json.Значение.Строка(нк.redirect_uri)),
					("scope", json.Значение.Строка(нк.scope))
				)))
				пер рез = http_post("/api/клиенты", тело, м.сессия.токен)
				выбор рез
					Есть(тело_ответа) тогда
						пер секрет = json.разобрать(тело_ответа).получить(json.Значение.Ноль).поле("client_secret").получить(json.Значение.Ноль).как_строку().получить("")
						если длина(секрет) > 0 тогда
							м.сообщения.новый_секрет = "client_secret (показан один раз): " + секрет
						иначе
							м.сообщения.новый_секрет = "публичный клиент — секрета нет, аутентификация только через PKCE"
						конец
					конец
					Нет тогда
						м.сообщения.новый_секрет = "не удалось создать клиента"
					конец
				конец
				загрузить_клиентов(м)
			конец
		конец
		УдалитьКлиента(ид) тогда
			http_delete("/api/клиенты/" + ид, м.сессия.токен)
			загрузить_клиентов(м)
		конец
		НачатьРедКлиента(ид) тогда
			м.сессия.editing_id = ид
		конец
		СохранитьКлиента(имя, redirect_uri, scope) тогда
			если длина(м.сессия.editing_id) > 0 и длина(имя) > 0 и длина(redirect_uri) > 0 тогда
				пер тело = json.сериализовать(json.объект(массив(
					("имя", json.Значение.Строка(имя)),
					("redirect_uri", json.Значение.Строка(redirect_uri)),
					("scope", json.Значение.Строка(scope))
				)))
				http_put("/api/клиенты/" + м.сессия.editing_id, тело, м.сессия.токен)
				м.сессия.editing_id = ""
				загрузить_клиентов(м)
			конец
		конец
		ПереключитьСтадию(вид, новое) тогда
			пер тело = json.сериализовать(json.список(массив(json.объект(массив(("вид", json.Значение.Строка(вид)), ("включена", json.Значение.Булево(новое)))))))
			http_put("/api/стадии", тело, м.сессия.токен)
			загрузить_стадии(м)
		конец
	конец
	м
конец

функ отправить_сообщение(сообщение: Сообщение) -> Пусто
	пер модель_текст = марьяшка.текущая_модель()
	пер новая_модель = обновить(сообщение, разобрать_модель(модель_текст))
	марьяшка.смонтировать("#корень", сериализовать_модель(новая_модель), отрисовать)
конец

// --- Отрисовка ---

функ найти_пользователя(м: Модель, ид: Строка) -> Опция(Пользователь)
	для п в м.данные.пользователи цикл
		если п.ид == ид тогда
			возврат Опция.Есть(п)
		конец
	конец
	Опция.Нет()
конец

функ найти_клиента(м: Модель, ид: Строка) -> Опция(Клиент)
	для к в м.данные.кс.клиенты цикл
		если к.client_id == ид тогда
			возврат Опция.Есть(к)
		конец
	конец
	Опция.Нет()
конец

функ класс_вкладки(активна: Булево) -> Строка
	если активна тогда "вкладка вкладка-активна" иначе "вкладка" конец
конец

функ ряд_с_кнопками(ключ: Строка, текст_ряда: Строка, кнопки: Массив(узел.Узел)) -> узел.Узел
	пер дети: Массив(узел.Узел) = массив()
	дети.добавить(узел.элемент("span", массив(), массив(узел.текст(текст_ряда))))
	для к в кнопки цикл
		дети.добавить(к)
	конец
	узел.с_ключом(ключ, узел.элемент("li", массив(узел.атрибут("class", "запись")), дети))
конец

функ кнопка_вторичная(текст_кнопки: Строка, обработчик: функ(DOM.СобытиеКлика) -> Пусто) -> узел.Узел
	узел.с_кликом(узел.элемент("button", массив(узел.атрибут("class", "кнопка-вторичная")), массив(узел.текст(текст_кнопки))), обработчик)
конец

функ кнопка_удалить(обработчик: функ(DOM.СобытиеКлика) -> Пусто) -> узел.Узел
	узел.с_кликом(узел.элемент("button", массив(узел.атрибут("class", "кнопка-удалить")), массив(узел.текст("✕"))), обработчик)
конец

// Адресация полей — через фреймворковый узел.с_адресуемым_id/
// узел.селектор (см. panosiki/марьяшка/узел.pns), не через ручной
// узел.атрибут("id", ...) — см. объяснение в диф.pns/узел.pns почему
// перезапись "id" ломает адресацию диф.pns на следующем ре-рендере.
функ поле_ввода(ид: Строка, тип_поля: Строка, плейсхолдер: Строка) -> узел.Узел
	узел.с_адресуемым_id(ид, узел.элемент("input", массив(узел.атрибут("type", тип_поля), узел.атрибут("placeholder", плейсхолдер)), массив()))
конец

функ поле_ввода_со_значением(ид: Строка, тип_поля: Строка, значение: Строка) -> узел.Узел
	узел.с_адресуемым_id(ид, узел.элемент("input", массив(узел.атрибут("type", тип_поля), узел.атрибут("value", значение)), массив()))
конец

функ селектор_поля(ид: Строка) -> Строка
	узел.селектор(ид)
конец

// --- Экран логина ---

функ на_войти(_: DOM.СобытиеКлика) -> Пусто
	пер логин = DOM.значение_поля(селектор_поля("логин-поле"))
	пер пароль = DOM.значение_поля(селектор_поля("пароль-поле"))
	отправить_сообщение(Сообщение.ВвестиЛогин(логин, пароль))
конец

функ экран_логина(м: Модель) -> узел.Узел
	пер класс = если длина(м.сессия.токен) == 0 тогда "панель" иначе "скрыто" конец
	узел.с_ключом("панель-логина", узел.элемент("div", массив(узел.атрибут("class", класс)), массив(
		узел.элемент("div", массив(узел.атрибут("class", "карточка-логина")), массив(
			узел.элемент("div", массив(узел.атрибут("class", "бренд")), массив(
				узел.элемент("div", массив(узел.атрибут("class", "бренд-значок")), массив(узел.текст("Д"))),
				узел.элемент("div", массив(узел.атрибут("class", "бренд-текст")), массив(узел.текст("дозорный")))
			)),
			узел.элемент("h2", массив(), массив(узел.текст("Вход в админку"))),
			узел.элемент("p", массив(узел.атрибут("class", "подсказка")), массив(узел.текст("Учётные данные администратора дозорного."))),
			узел.элемент("div", массив(узел.атрибут("class", "поле-группа")), массив(
				узел.элемент("label", массив(), массив(узел.текст("Логин"))),
				поле_ввода("логин-поле", "text", "admin")
			)),
			узел.элемент("div", массив(узел.атрибут("class", "поле-группа")), массив(
				узел.элемент("label", массив(), массив(узел.текст("Пароль"))),
				поле_ввода("пароль-поле", "password", "••••••••")
			)),
			узел.с_кликом(узел.с_ключом("кнопка-войти", узел.элемент("button", массив(), массив(узел.текст("Войти")))), на_войти),
			узел.элемент("p", массив(узел.атрибут("class", "ошибка")), массив(узел.текст(м.сообщения.ошибка_логина)))
		))
	)))
конец

// --- Пользователи ---

функ на_добавить_пользователя(_: DOM.СобытиеКлика) -> Пусто
	пер логин = DOM.значение_поля(селектор_поля("новый-пользователь-логин"))
	пер пароль = DOM.значение_поля(селектор_поля("новый-пользователь-пароль"))
	пер email = DOM.значение_поля(селектор_поля("новый-пользователь-email"))
	DOM.установить_значение_поля(селектор_поля("новый-пользователь-логин"), "")
	DOM.установить_значение_поля(селектор_поля("новый-пользователь-пароль"), "")
	DOM.установить_значение_поля(селектор_поля("новый-пользователь-email"), "")
	отправить_сообщение(Сообщение.ДобавитьПользователя(логин, пароль, email))
конец

функ на_сохранить_пользователя(_: DOM.СобытиеКлика) -> Пусто
	пер email = DOM.значение_поля(селектор_поля("ред-польз-email"))
	пер активен_текст = DOM.значение_поля(селектор_поля("ред-польз-активен"))
	отправить_сообщение(Сообщение.СохранитьПользователя(email, активен_текст))
конец

функ строка_пользователя(п: Пользователь) -> узел.Узел
	пер ид = п.ид
	пер текст_ряда = п.логин + " (" + п.инфо.email + ") " + если п.инфо.активен тогда "[активен]" иначе "[выключен]" конец
	ряд_с_кнопками("пользователь-" + ид, текст_ряда, массив(
		кнопка_вторичная("✎", функ(_: DOM.СобытиеКлика) -> Пусто отправить_сообщение(Сообщение.НачатьРедПользователя(ид)) конец),
		кнопка_удалить(функ(_: DOM.СобытиеКлика) -> Пусто отправить_сообщение(Сообщение.УдалитьПользователя(ид)) конец)
	))
конец

функ панель_редактирования_пользователя(м: Модель) -> Массив(узел.Узел)
	если длина(м.сессия.editing_id) == 0 тогда
		возврат массив()
	конец
	пер найден = найти_пользователя(м, м.сессия.editing_id)
	пер email = найден.получить(Пользователь("", "", ПользовательИнфо("", ложь))).инфо.email
	массив(узел.элемент("div", массив(узел.атрибут("class", "форма")), массив(
		поле_ввода_со_значением("ред-польз-email", "text", email),
		поле_ввода("ред-польз-активен", "text", "да/нет"),
		узел.с_кликом(узел.элемент("button", массив(), массив(узел.текст("Сохранить"))), на_сохранить_пользователя)
	)))
конец

функ раздел_пользователей(м: Модель) -> узел.Узел
	пер строки_узлы: Массив(узел.Узел) = массив()
	для п в м.данные.пользователи цикл
		строки_узлы.добавить(строка_пользователя(п))
	конец
	пер дети: Массив(узел.Узел) = массив()
	дети.добавить(узел.элемент("p", массив(узел.атрибут("class", "раздел-заголовок")), массив(узел.текст("Пользователи"))))
	дети.добавить(узел.элемент("div", массив(узел.атрибут("class", "форма")), массив(
		поле_ввода("новый-пользователь-логин", "text", "логин"),
		поле_ввода("новый-пользователь-пароль", "password", "пароль"),
		поле_ввода("новый-пользователь-email", "text", "email"),
		узел.с_кликом(узел.элемент("button", массив(), массив(узел.текст("Добавить"))), на_добавить_пользователя)
	)))
	для узел_панели в панель_редактирования_пользователя(м) цикл
		дети.добавить(узел_панели)
	конец
	дети.добавить(узел.элемент("ul", массив(), строки_узлы))
	узел.элемент("div", массив(узел.атрибут("class", "раздел")), дети)
конец

// --- Группы ---

функ на_добавить_группу(_: DOM.СобытиеКлика) -> Пусто
	пер имя = DOM.значение_поля(селектор_поля("новая-группа-имя"))
	DOM.установить_значение_поля(селектор_поля("новая-группа-имя"), "")
	отправить_сообщение(Сообщение.ДобавитьГруппу(имя))
конец

функ строка_группы(г: Группа) -> узел.Узел
	пер ид = г.ид
	ряд_с_кнопками("группа-" + ид, г.имя, массив(
		кнопка_удалить(функ(_: DOM.СобытиеКлика) -> Пусто отправить_сообщение(Сообщение.УдалитьГруппу(ид)) конец)
	))
конец

функ раздел_групп(м: Модель) -> узел.Узел
	пер строки_узлы: Массив(узел.Узел) = массив()
	для г в м.данные.группы цикл
		строки_узлы.добавить(строка_группы(г))
	конец
	узел.элемент("div", массив(узел.атрибут("class", "раздел")), массив(
		узел.элемент("p", массив(узел.атрибут("class", "раздел-заголовок")), массив(узел.текст("Группы"))),
		узел.элемент("div", массив(узел.атрибут("class", "форма")), массив(
			поле_ввода("новая-группа-имя", "text", "имя группы"),
			узел.с_кликом(узел.элемент("button", массив(), массив(узел.текст("Добавить"))), на_добавить_группу)
		)),
		узел.элемент("ul", массив(), строки_узлы)
	))
конец

// --- Клиенты ---

функ на_добавить_клиента(_: DOM.СобытиеКлика) -> Пусто
	пер имя = DOM.значение_поля(селектор_поля("новый-клиент-имя"))
	пер redirect_uri = DOM.значение_поля(селектор_поля("новый-клиент-redirect"))
	пер scope = DOM.значение_поля(селектор_поля("новый-клиент-scope"))
	DOM.установить_значение_поля(селектор_поля("новый-клиент-имя"), "")
	DOM.установить_значение_поля(селектор_поля("новый-клиент-redirect"), "")
	DOM.установить_значение_поля(селектор_поля("новый-клиент-scope"), "")
	отправить_сообщение(Сообщение.ДобавитьКлиента(НовыйКлиент(имя, redirect_uri, scope)))
конец

функ на_сохранить_клиента(_: DOM.СобытиеКлика) -> Пусто
	пер имя = DOM.значение_поля(селектор_поля("ред-клиент-имя"))
	пер redirect_uri = DOM.значение_поля(селектор_поля("ред-клиент-redirect"))
	пер scope = DOM.значение_поля(селектор_поля("ред-клиент-scope"))
	отправить_сообщение(Сообщение.СохранитьКлиента(имя, redirect_uri, scope))
конец

функ безопасный_id(текст: Строка) -> Строка
	строки.заменить(текст, "_", "-")
конец

функ строка_клиента(к: Клиент) -> узел.Узел
	пер ид = к.client_id
	пер текст_ряда = к.имя + " (" + к.client_id + ")" + если к.публичный тогда " [публичный]" иначе "" конец
	ряд_с_кнопками("клиент-" + безопасный_id(ид), текст_ряда, массив(
		кнопка_вторичная("✎", функ(_: DOM.СобытиеКлика) -> Пусто отправить_сообщение(Сообщение.НачатьРедКлиента(ид)) конец),
		кнопка_удалить(функ(_: DOM.СобытиеКлика) -> Пусто отправить_сообщение(Сообщение.УдалитьКлиента(ид)) конец)
	))
конец

// redirect_uri/scope не предзаполняются при редактировании — тот же
// известный компромисс, что был в ручной версии (список /api/клиенты
// их не парсит, PUT заменяет оба поля разом, вводить нужно заново).
функ панель_редактирования_клиента(м: Модель) -> Массив(узел.Узел)
	если длина(м.сессия.editing_id) == 0 тогда
		возврат массив()
	конец
	пер найден = найти_клиента(м, м.сессия.editing_id)
	пер имя = найден.получить(Клиент("", "", ложь)).имя
	массив(узел.элемент("div", массив(узел.атрибут("class", "форма")), массив(
		поле_ввода_со_значением("ред-клиент-имя", "text", имя),
		поле_ввода("ред-клиент-redirect", "text", "redirect_uri (ввести заново)"),
		поле_ввода("ред-клиент-scope", "text", "scope (ввести заново)"),
		узел.с_кликом(узел.элемент("button", массив(), массив(узел.текст("Сохранить"))), на_сохранить_клиента)
	)))
конец

функ раздел_клиентов(м: Модель) -> узел.Узел
	пер строки_узлы: Массив(узел.Узел) = массив()
	для к в м.данные.кс.клиенты цикл
		строки_узлы.добавить(строка_клиента(к))
	конец
	пер дети: Массив(узел.Узел) = массив()
	дети.добавить(узел.элемент("p", массив(узел.атрибут("class", "раздел-заголовок")), массив(узел.текст("OAuth2-клиенты"))))
	дети.добавить(узел.элемент("div", массив(узел.атрибут("class", "форма")), массив(
		поле_ввода("новый-клиент-имя", "text", "имя приложения"),
		поле_ввода("новый-клиент-redirect", "text", "redirect_uri"),
		поле_ввода("новый-клиент-scope", "text", "scope (openid profile)"),
		узел.с_кликом(узел.элемент("button", массив(), массив(узел.текст("Добавить"))), на_добавить_клиента)
	)))
	если длина(м.сообщения.новый_секрет) > 0 тогда
		дети.добавить(узел.с_адресуемым_id("новый-секрет", узел.элемент("p", массив(), массив(узел.текст(м.сообщения.новый_секрет)))))
	конец
	для узел_панели в панель_редактирования_клиента(м) цикл
		дети.добавить(узел_панели)
	конец
	дети.добавить(узел.элемент("ul", массив(), строки_узлы))
	узел.элемент("div", массив(узел.атрибут("class", "раздел")), дети)
конец

// --- Стадии ---

функ строка_стадии(с: Стадия) -> узел.Узел
	пер вид = с.вид
	пер обязательна = вид == "login"
	пер текст_ряда = вид + если обязательна тогда " (обязательная)" иначе "" конец
	пер кнопки: Массив(узел.Узел) = массив()
	если не обязательна тогда
		пер новое = не с.включена
		пер текст_кнопки = если с.включена тогда "выключить" иначе "включить" конец
		кнопки.добавить(кнопка_вторичная(текст_кнопки, функ(_: DOM.СобытиеКлика) -> Пусто отправить_сообщение(Сообщение.ПереключитьСтадию(вид, новое)) конец))
	конец
	ряд_с_кнопками("стадия-" + вид, текст_ряда, кнопки)
конец

функ раздел_стадий(м: Модель) -> узел.Узел
	пер строки_узлы: Массив(узел.Узел) = массив()
	для с в м.данные.кс.стадии цикл
		строки_узлы.добавить(строка_стадии(с))
	конец
	узел.элемент("div", массив(узел.атрибут("class", "раздел")), массив(
		узел.элемент("p", массив(узел.атрибут("class", "раздел-заголовок")), массив(узел.текст("Стадии flow"))),
		узел.элемент("ul", массив(), строки_узлы)
	))
конец

// --- Оболочка приложения ---

функ вкладка(текст_вкладки: Строка, раздел: Строка, активна: Булево) -> узел.Узел
	узел.с_кликом(узел.элемент("button", массив(узел.атрибут("class", класс_вкладки(активна))), массив(узел.текст(текст_вкладки))), функ(_: DOM.СобытиеКлика) -> Пусто отправить_сообщение(Сообщение.ПереключитьРаздел(раздел)) конец)
конец

функ содержимое_раздела(м: Модель) -> узел.Узел
	если м.сессия.раздел == "группы" тогда
		возврат раздел_групп(м)
	конец
	если м.сессия.раздел == "клиенты" тогда
		возврат раздел_клиентов(м)
	конец
	если м.сессия.раздел == "стадии" тогда
		возврат раздел_стадий(м)
	конец
	раздел_пользователей(м)
конец

функ на_выйти(_: DOM.СобытиеКлика) -> Пусто
	отправить_сообщение(Сообщение.Выход)
конец

функ экран_приложения(м: Модель) -> узел.Узел
	пер класс = если длина(м.сессия.токен) > 0 тогда "панель" иначе "скрыто" конец
	узел.с_ключом("приложение", узел.элемент("div", массив(узел.атрибут("class", класс)), массив(
		узел.элемент("div", массив(узел.атрибут("class", "шапка")), массив(
			узел.элемент("div", массив(узел.атрибут("class", "бренд")), массив(
				узел.элемент("div", массив(узел.атрибут("class", "бренд-значок")), массив(узел.текст("Д"))),
				узел.элемент("div", массив(узел.атрибут("class", "бренд-текст")), массив(узел.текст("дозорный")))
			)),
			узел.с_кликом(узел.элемент("button", массив(узел.атрибут("class", "кнопка-вторичная")), массив(узел.текст("Выйти"))), на_выйти)
		)),
		узел.элемент("div", массив(узел.атрибут("class", "контейнер")), массив(
			узел.элемент("div", массив(узел.атрибут("class", "вкладки")), массив(
				вкладка("Пользователи", "пользователи", м.сессия.раздел == "пользователи"),
				вкладка("Группы", "группы", м.сессия.раздел == "группы"),
				вкладка("Клиенты", "клиенты", м.сессия.раздел == "клиенты"),
				вкладка("Стадии", "стадии", м.сессия.раздел == "стадии")
			)),
			содержимое_раздела(м)
		))
	)))
конец

функ отрисовать(модель_текст: Строка) -> узел.Узел
	пер м = разобрать_модель(модель_текст)
	узел.элемент("div", массив(), массив(
		экран_логина(м),
		экран_приложения(м)
	))
конец

// --- Точка входа ---

функ старт() -> Пусто
	пер модель_текст = марьяшка.текущая_модель()
	пер эффективная = если длина(модель_текст) == 0 тогда сериализовать_модель(новая_модель()) иначе модель_текст конец
	марьяшка.смонтировать("#корень", эффективная, отрисовать)
конец
