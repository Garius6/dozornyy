// main.pns — admin SPA для дозорного, AOT-компилируется в WASM (тот же
// browser-тулчейн, что demo/todo-app/frontend: DOM.*/состояние.*,
// сеть.http_запрос_sync(_с_заголовками), никакого JS-фреймворка).
//
// Состояние между обработчиками кликов — ОДНА строка, которую держит
// JS-загрузчик (состояние.прочитать/.записать, см. todo-app's
// project_panos_elm_architecture_dom_storage_design) — WASM не переживает
// отдельный вызов, поэтому здесь закодированы ТРИ поля одной строкой
// через "|": "<admin-токен>|<текущий раздел>|<ид редактируемой записи>".
// Раздел == "" — экран логина (токена ещё нет).

импорт DOM
импорт состояние
импорт "сеть" как сеть
импорт строки

// --- Кодирование состояния ---

тип Сессия = структура
	токен:      Строка
	раздел:     Строка
	editing_id: Строка
конец

функ разобрать_сессию(сырое: Строка) -> Сессия
	пер части = строки.разбить(сырое, "|")
	Сессия(части.получить(0, ""), части.получить(1, ""), части.получить(2, ""))
конец

функ сохранить_сессию(с: Сессия) -> Пусто
	состояние.записать(с.токен + "|" + с.раздел + "|" + с.editing_id)
конец

функ текущая_сессия() -> Сессия
	разобрать_сессию(состояние.прочитать())
конец

// --- HTTP-помощники (JSON-тело, Authorization при наличии токена) ---

функ http_get(путь: Строка, токен: Строка) -> Опция(Строка)
	сеть.http_запрос_sync_с_заголовками("GET", путь, "", "Authorization: Bearer " + токен)
конец

функ http_post(путь: Строка, тело: Строка, токен: Строка) -> Опция(Строка)
	сеть.http_запрос_sync_с_заголовками("POST", путь, тело, "Authorization: Bearer " + токен)
конец

функ http_put(путь: Строка, тело: Строка, токен: Строка) -> Опция(Строка)
	сеть.http_запрос_sync_с_заголовками("PUT", путь, тело, "Authorization: Bearer " + токен)
конец

функ http_delete(путь: Строка, токен: Строка) -> Опция(Строка)
	сеть.http_запрос_sync_с_заголовками("DELETE", путь, "", "Authorization: Bearer " + токен)
конец

// --- Минимальный JSON: извлечение плоских полей (строка/число/булево) ---
// Тот же приём, что todo-app/frontend/main.pns — рунные (не байтовые)
// индексы строки.найти/.срез, реальный баг, найденный запуском там же.
// Вложенные массивы ("группы"/"redirect_uris"/"scopes") здесь НЕ
// парсятся — списки/формы этой SPA их не показывают (см. модель.pns —
// это read-back-детали, не то, что админ редактирует напрямую).

функ извлечь_поле(объект: Строка, ключ: Строка) -> Опция(Строка)
	пер маркер = "\"" + ключ + "\":"
	пер позиция = строки.найти(объект, маркер, 0)
	если позиция < 0 тогда
		возврат Опция.Нет()
	конец
	пер начало = позиция + длина(маркер)
	пер остаток = строки.срез(объект, начало, длина(объект))
	если строки.начинается_с(остаток, "\"") тогда
		пер без_кавычки = строки.срез(остаток, 1, длина(остаток))
		пер конец_строки = найти_неэкранированную_кавычку(без_кавычки)
		если конец_строки < 0 тогда
			возврат Опция.Нет()
		конец
		возврат Опция.Есть(строки.срез(без_кавычки, 0, конец_строки))
	конец
	если строки.начинается_с(остаток, "[") тогда
		пер конец_массива = строки.найти(остаток, "]", 0)
		если конец_массива < 0 тогда
			возврат Опция.Нет()
		конец
		возврат Опция.Есть(строки.срез(остаток, 0, конец_массива + 1))
	конец
	пер запятая = строки.найти(остаток, ",", 0)
	пер скобка = строки.найти(остаток, "}", 0)
	пер граница: Целое = длина(остаток)
	если запятая >= 0 и (скобка < 0 или запятая < скобка) тогда
		граница = запятая
	иначе
		если скобка >= 0 тогда
			граница = скобка
		конец
	конец
	Опция.Есть(строки.срез(остаток, 0, граница))
конец

функ найти_неэкранированную_кавычку(текст: Строка) -> Целое
	пер поиск_от: Целое = 0
	пока истина цикл
		пер поз = строки.найти(текст, "\"", поиск_от)
		если поз < 0 тогда
			возврат -1
		конец
		если поз == 0 тогда
			возврат поз
		конец
		если строки.срез(текст, поз - 1, поз) <> "\\" тогда
			возврат поз
		конец
		поиск_от = поз + 1
	конец
	пер запасное: Целое = -1
	запасное
конец

функ извлечь_строку(объект: Строка, ключ: Строка) -> Строка
	извлечь_поле(объект, ключ).получить("")
конец

функ извлечь_булево(объект: Строка, ключ: Строка) -> Булево
	извлечь_поле(объект, ключ).получить("false") == "true"
конец

// "},{" — тот же приём (и то же известное упрощение: значение поля не
// может содержать буквальную "},{"), что todo-app/frontend/main.pns.
функ разбить_json_список(тело: Строка) -> Массив(Строка)
	пер результат: Массив(Строка) = массив()
	пер очищено = строки.заменить(строки.заменить(тело, "[", ""), "]", "")
	если длина(очищено) == 0 тогда
		возврат результат
	конец
	пер части = строки.разбить(очищено, "},{")
	пер n = части.длина()
	если n > 0 тогда
		для i = 0 по n - 1 цикл
			результат.добавить(части.получить(i, ""))
		конец
	конец
	результат
конец

функ экранировать_json(текст: Строка) -> Строка
	строки.заменить(строки.заменить(текст, "\\", "\\\\"), "\"", "\\\"")
конец

функ jstr(текст: Строка) -> Строка
	"\"" + экранировать_json(текст) + "\""
конец

// --- Экран логина ---

функ показать_логин() -> Пусто
	DOM.установить_атрибут("#панель-логина", "class", "панель")
	DOM.установить_атрибут("#приложение", "class", "скрыто")
конец

функ показать_приложение() -> Пусто
	DOM.установить_атрибут("#панель-логина", "class", "скрыто")
	DOM.установить_атрибут("#приложение", "class", "панель")
конец

функ обработать_вход() -> Пусто
	пер логин = DOM.значение_поля("#логин-поле")
	пер пароль = DOM.значение_поля("#пароль-поле")
	пер тело = "{" + jstr("логин") + ":" + jstr(логин) + "," + jstr("пароль") + ":" + jstr(пароль) + "}"
	пер рез = сеть.http_запрос_sync("POST", "/api/вход", тело)
	выбор рез
		Есть(тело_ответа) тогда
			пер токен = извлечь_строку(тело_ответа, "токен")
			если длина(токен) > 0 тогда
				сохранить_сессию(Сессия(токен, "пользователи", ""))
				показать_приложение()
				перерисовать_раздел()
			иначе
				DOM.установить_текст_строка("#ошибка-логина", "неверный логин или пароль")
			конец
		конец
		Нет тогда
			DOM.установить_текст_строка("#ошибка-логина", "не удалось связаться с сервером")
		конец
	конец
конец

функ обработать_выход() -> Пусто
	сохранить_сессию(Сессия("", "", ""))
	показать_логин()
конец

// --- Навигация ---

функ переключить_раздел(раздел: Строка) -> Пусто
	пер с = текущая_сессия()
	сохранить_сессию(Сессия(с.токен, раздел, ""))
	перерисовать_раздел()
конец

функ класс_вкладки(активна: Булево) -> Строка
	если активна тогда "вкладка вкладка-активна" иначе "вкладка" конец
конец

функ перерисовать_раздел() -> Пусто
	пер с = текущая_сессия()
	DOM.установить_атрибут("#вкладка-пользователи", "class", класс_вкладки(с.раздел == "пользователи"))
	DOM.установить_атрибут("#вкладка-группы", "class", класс_вкладки(с.раздел == "группы"))
	DOM.установить_атрибут("#вкладка-клиенты", "class", класс_вкладки(с.раздел == "клиенты"))
	DOM.установить_атрибут("#вкладка-стадии", "class", класс_вкладки(с.раздел == "стадии"))

	DOM.установить_атрибут("#раздел-пользователи", "class", если с.раздел == "пользователи" тогда "раздел" иначе "скрыто" конец)
	DOM.установить_атрибут("#раздел-группы", "class", если с.раздел == "группы" тогда "раздел" иначе "скрыто" конец)
	DOM.установить_атрибут("#раздел-клиенты", "class", если с.раздел == "клиенты" тогда "раздел" иначе "скрыто" конец)
	DOM.установить_атрибут("#раздел-стадии", "class", если с.раздел == "стадии" тогда "раздел" иначе "скрыто" конец)

	если с.раздел == "пользователи" тогда
		перерисовать_пользователей(с.токен)
	конец
	если с.раздел == "группы" тогда
		перерисовать_группы(с.токен)
	конец
	если с.раздел == "клиенты" тогда
		перерисовать_клиенты(с.токен)
	конец
	если с.раздел == "стадии" тогда
		перерисовать_стадии(с.токен)
	конец
конец

// --- Пользователи ---

функ перерисовать_пользователей(токен: Строка) -> Пусто
	DOM.установить_текст_строка("#список-пользователей", "")
	пер тело = http_get("/api/пользователи", токен).получить("[]")
	пер объекты = разбить_json_список(тело)
	пер n = объекты.длина()
	если n > 0 тогда
		для i = 0 по n - 1 цикл
			отрисовать_пользователя(объекты.получить(i, ""))
		конец
	конец
конец

функ отрисовать_пользователя(объект: Строка) -> Пусто
	пер ид = извлечь_строку(объект, "ид")
	пер логин = извлечь_строку(объект, "логин")
	пер email = извлечь_строку(объект, "email")
	пер активен = извлечь_булево(объект, "активен")
	пер строка_id = "#пользователь-" + ид
	DOM.создать_и_добавить("#список-пользователей", "li", "пользователь-" + ид)
	DOM.установить_атрибут(строка_id, "class", "запись")
	DOM.создать_и_добавить(строка_id, "span", "пользователь-текст-" + ид)
	DOM.установить_текст_строка("#пользователь-текст-" + ид, логин + " (" + email + ") " + если активен тогда "[активен]" иначе "[выключен]" конец)
	DOM.создать_и_добавить(строка_id, "button", "пользователь-редактировать-" + ид)
	DOM.установить_атрибут("#пользователь-редактировать-" + ид, "class", "кнопка-вторичная")
	DOM.установить_текст_строка("#пользователь-редактировать-" + ид, "✎")
	DOM.на_клик("#пользователь-редактировать-" + ид, функ(_: DOM.СобытиеКлика) -> Пусто
		начать_редактирование_пользователя(ид, email, активен)
	конец)
	DOM.создать_и_добавить(строка_id, "button", "пользователь-удалить-" + ид)
	DOM.установить_атрибут("#пользователь-удалить-" + ид, "class", "кнопка-удалить")
	DOM.установить_текст_строка("#пользователь-удалить-" + ид, "✕")
	DOM.на_клик("#пользователь-удалить-" + ид, функ(_: DOM.СобытиеКлика) -> Пусто
		обработать_удалить_пользователя(ид)
	конец)
конец

функ начать_редактирование_пользователя(ид: Строка, email: Строка, активен: Булево) -> Пусто
	пер с = текущая_сессия()
	сохранить_сессию(Сессия(с.токен, с.раздел, ид))
	DOM.установить_атрибут("#панель-ред-пользователя", "class", "форма")
	DOM.установить_значение_поля("#ред-польз-email", email)
	DOM.установить_значение_поля("#ред-польз-активен", если активен тогда "да" иначе "нет" конец)
конец

функ обработать_сохранить_пользователя() -> Пусто
	пер с = текущая_сессия()
	если длина(с.editing_id) == 0 тогда
		возврат
	конец
	пер email = DOM.значение_поля("#ред-польз-email")
	пер активен_текст = DOM.значение_поля("#ред-польз-активен")
	пер активен = активен_текст == "да" или активен_текст == "yes" или активен_текст == "true"
	пер тело = "{" + jstr("email") + ":" + jstr(email) + "," + jstr("активен") + ":" + если активен тогда "true" иначе "false" конец + "}"
	http_put("/api/пользователи/" + с.editing_id, тело, с.токен)
	DOM.установить_атрибут("#панель-ред-пользователя", "class", "скрыто")
	сохранить_сессию(Сессия(с.токен, с.раздел, ""))
	перерисовать_раздел()
конец

функ обработать_добавить_пользователя() -> Пусто
	пер с = текущая_сессия()
	пер логин = DOM.значение_поля("#новый-пользователь-логин")
	пер пароль = DOM.значение_поля("#новый-пользователь-пароль")
	пер email = DOM.значение_поля("#новый-пользователь-email")
	если длина(логин) == 0 или длина(пароль) == 0 тогда
		перерисовать_раздел()
	иначе
		пер тело = "{" + jstr("логин") + ":" + jstr(логин) + "," + jstr("пароль") + ":" + jstr(пароль) + "," + jstr("email") + ":" + jstr(email) + "}"
		http_post("/api/пользователи", тело, с.токен)
		DOM.установить_значение_поля("#новый-пользователь-логин", "")
		DOM.установить_значение_поля("#новый-пользователь-пароль", "")
		DOM.установить_значение_поля("#новый-пользователь-email", "")
		перерисовать_раздел()
	конец
конец

функ обработать_удалить_пользователя(ид: Строка) -> Пусто
	пер с = текущая_сессия()
	http_delete("/api/пользователи/" + ид, с.токен)
	перерисовать_раздел()
конец

// --- Группы ---

функ перерисовать_группы(токен: Строка) -> Пусто
	DOM.установить_текст_строка("#список-групп", "")
	пер тело = http_get("/api/группы", токен).получить("[]")
	пер объекты = разбить_json_список(тело)
	пер n = объекты.длина()
	если n > 0 тогда
		для i = 0 по n - 1 цикл
			отрисовать_группу(объекты.получить(i, ""))
		конец
	конец
конец

функ отрисовать_группу(объект: Строка) -> Пусто
	пер ид = извлечь_строку(объект, "ид")
	пер имя = извлечь_строку(объект, "имя")
	пер строка_id = "#группа-" + ид
	DOM.создать_и_добавить("#список-групп", "li", "группа-" + ид)
	DOM.установить_атрибут(строка_id, "class", "запись")
	DOM.создать_и_добавить(строка_id, "span", "группа-текст-" + ид)
	DOM.установить_текст_строка("#группа-текст-" + ид, имя)
	DOM.создать_и_добавить(строка_id, "button", "группа-удалить-" + ид)
	DOM.установить_атрибут("#группа-удалить-" + ид, "class", "кнопка-удалить")
	DOM.установить_текст_строка("#группа-удалить-" + ид, "✕")
	DOM.на_клик("#группа-удалить-" + ид, функ(_: DOM.СобытиеКлика) -> Пусто
		обработать_удалить_группу(ид)
	конец)
конец

функ обработать_добавить_группу() -> Пусто
	пер с = текущая_сессия()
	пер имя = DOM.значение_поля("#новая-группа-имя")
	если длина(имя) == 0 тогда
		перерисовать_раздел()
	иначе
		http_post("/api/группы", "{" + jstr("имя") + ":" + jstr(имя) + "}", с.токен)
		DOM.установить_значение_поля("#новая-группа-имя", "")
		перерисовать_раздел()
	конец
конец

функ обработать_удалить_группу(ид: Строка) -> Пусто
	пер с = текущая_сессия()
	http_delete("/api/группы/" + ид, с.токен)
	перерисовать_раздел()
конец

// --- Клиенты ---

функ перерисовать_клиенты(токен: Строка) -> Пусто
	DOM.установить_текст_строка("#список-клиентов", "")
	пер тело = http_get("/api/клиенты", токен).получить("[]")
	пер объекты = разбить_json_список(тело)
	пер n = объекты.длина()
	если n > 0 тогда
		для i = 0 по n - 1 цикл
			отрисовать_клиента(объекты.получить(i, ""))
		конец
	конец
конец

функ безопасный_id(текст: Строка) -> Строка
	строки.заменить(текст, "_", "-")
конец

функ отрисовать_клиента(объект: Строка) -> Пусто
	пер client_id = извлечь_строку(объект, "client_id")
	пер имя = извлечь_строку(объект, "имя")
	пер уид = безопасный_id(client_id)
	пер строка_id = "#клиент-" + уид
	DOM.создать_и_добавить("#список-клиентов", "li", "клиент-" + уид)
	DOM.установить_атрибут(строка_id, "class", "запись")
	DOM.создать_и_добавить(строка_id, "span", "клиент-текст-" + уид)
	DOM.установить_текст_строка("#клиент-текст-" + уид, имя + " (" + client_id + ")")
	DOM.создать_и_добавить(строка_id, "button", "клиент-редактировать-" + уид)
	DOM.установить_атрибут("#клиент-редактировать-" + уид, "class", "кнопка-вторичная")
	DOM.установить_текст_строка("#клиент-редактировать-" + уид, "✎")
	DOM.на_клик("#клиент-редактировать-" + уид, функ(_: DOM.СобытиеКлика) -> Пусто
		начать_редактирование_клиента(client_id, имя)
	конец)
	DOM.создать_и_добавить(строка_id, "button", "клиент-удалить-" + уид)
	DOM.установить_атрибут("#клиент-удалить-" + уид, "class", "кнопка-удалить")
	DOM.установить_текст_строка("#клиент-удалить-" + уид, "✕")
	DOM.на_клик("#клиент-удалить-" + уид, функ(_: DOM.СобытиеКлика) -> Пусто
		обработать_удалить_клиента(client_id)
	конец)
конец

// redirect_uri/scope НЕ предзаполняются — список /api/клиенты
// намеренно не парсит вложенные массивы (см. заголовок файла), так
// что при редактировании их нужно ввести заново целиком (PUT заменяет
// оба поля разом, не патчит по одному); известное упрощение, не
// потеря данных — сохранённые значения не показываются, но и не
// стираются, пока форма не отправлена.
функ начать_редактирование_клиента(client_id: Строка, имя: Строка) -> Пусто
	пер с = текущая_сессия()
	сохранить_сессию(Сессия(с.токен, с.раздел, client_id))
	DOM.установить_атрибут("#панель-ред-клиента", "class", "форма")
	DOM.установить_значение_поля("#ред-клиент-имя", имя)
	DOM.установить_значение_поля("#ред-клиент-redirect", "")
	DOM.установить_значение_поля("#ред-клиент-scope", "")
конец

функ обработать_сохранить_клиента() -> Пусто
	пер с = текущая_сессия()
	если длина(с.editing_id) == 0 тогда
		возврат
	конец
	пер имя = DOM.значение_поля("#ред-клиент-имя")
	пер redirect_uri = DOM.значение_поля("#ред-клиент-redirect")
	пер scope = DOM.значение_поля("#ред-клиент-scope")
	если длина(имя) == 0 или длина(redirect_uri) == 0 тогда
		возврат
	конец
	пер тело = "{" + jstr("имя") + ":" + jstr(имя) + "," + jstr("redirect_uri") + ":" + jstr(redirect_uri) + "," + jstr("scope") + ":" + jstr(scope) + "}"
	http_put("/api/клиенты/" + с.editing_id, тело, с.токен)
	DOM.установить_атрибут("#панель-ред-клиента", "class", "скрыто")
	сохранить_сессию(Сессия(с.токен, с.раздел, ""))
	перерисовать_раздел()
конец

функ обработать_добавить_клиента() -> Пусто
	пер с = текущая_сессия()
	пер имя = DOM.значение_поля("#новый-клиент-имя")
	пер redirect_uri = DOM.значение_поля("#новый-клиент-redirect")
	пер scope = DOM.значение_поля("#новый-клиент-scope")
	если длина(имя) == 0 или длина(redirect_uri) == 0 тогда
		перерисовать_раздел()
	иначе
		пер тело = "{" + jstr("имя") + ":" + jstr(имя) + "," + jstr("redirect_uri") + ":" + jstr(redirect_uri) + "," + jstr("scope") + ":" + jstr(scope) + "}"
		пер рез = http_post("/api/клиенты", тело, с.токен)
		выбор рез
			Есть(тело_ответа) тогда
				пер секрет = извлечь_строку(тело_ответа, "client_secret")
				DOM.установить_текст_строка("#новый-секрет", "client_secret (показан один раз): " + секрет)
			конец
			Нет тогда
				DOM.установить_текст_строка("#новый-секрет", "не удалось создать клиента")
			конец
		конец
		DOM.установить_значение_поля("#новый-клиент-имя", "")
		DOM.установить_значение_поля("#новый-клиент-redirect", "")
		DOM.установить_значение_поля("#новый-клиент-scope", "")
		перерисовать_раздел()
	конец
конец

функ обработать_удалить_клиента(client_id: Строка) -> Пусто
	пер с = текущая_сессия()
	http_delete("/api/клиенты/" + client_id, с.токен)
	перерисовать_раздел()
конец

// --- Стадии (упрощённый flow-движок) ---

функ перерисовать_стадии(токен: Строка) -> Пусто
	DOM.установить_текст_строка("#список-стадий", "")
	пер тело = http_get("/api/стадии", токен).получить("[]")
	пер объекты = разбить_json_список(тело)
	пер n = объекты.длина()
	если n > 0 тогда
		для i = 0 по n - 1 цикл
			отрисовать_стадию(объекты.получить(i, ""))
		конец
	конец
конец

функ отрисовать_стадию(объект: Строка) -> Пусто
	пер вид = извлечь_строку(объект, "вид")
	пер включена = извлечь_булево(объект, "включена")
	пер обязательна = вид == "login"
	пер строка_id = "#стадия-" + вид
	DOM.создать_и_добавить("#список-стадий", "li", "стадия-" + вид)
	DOM.установить_атрибут(строка_id, "class", "запись")
	DOM.создать_и_добавить(строка_id, "span", "стадия-текст-" + вид)
	DOM.установить_текст_строка("#стадия-текст-" + вид, вид + если обязательна тогда " (обязательная)" иначе "" конец)
	если не обязательна тогда
		DOM.создать_и_добавить(строка_id, "button", "стадия-переключить-" + вид)
		DOM.установить_атрибут("#стадия-переключить-" + вид, "class", "кнопка-вторичная")
		DOM.установить_текст_строка("#стадия-переключить-" + вид, если включена тогда "выключить" иначе "включить" конец)
		DOM.на_клик("#стадия-переключить-" + вид, функ(_: DOM.СобытиеКлика) -> Пусто
			обработать_переключить_стадию(вид, не включена)
		конец)
	конец
конец

функ обработать_переключить_стадию(вид: Строка, новое_состояние: Булево) -> Пусто
	пер с = текущая_сессия()
	пер тело = "[{" + jstr("вид") + ":" + jstr(вид) + "," + jstr("включена") + ":" + если новое_состояние тогда "true" иначе "false" конец + "}]"
	http_put("/api/стадии", тело, с.токен)
	перерисовать_раздел()
конец

// --- Точка входа ---

функ старт() -> Пусто
	DOM.на_клик("#кнопка-войти", функ(_: DOM.СобытиеКлика) -> Пусто обработать_вход() конец)
	DOM.на_клик("#кнопка-выйти", функ(_: DOM.СобытиеКлика) -> Пусто обработать_выход() конец)
	DOM.на_клик("#вкладка-пользователи", функ(_: DOM.СобытиеКлика) -> Пусто переключить_раздел("пользователи") конец)
	DOM.на_клик("#вкладка-группы", функ(_: DOM.СобытиеКлика) -> Пусто переключить_раздел("группы") конец)
	DOM.на_клик("#вкладка-клиенты", функ(_: DOM.СобытиеКлика) -> Пусто переключить_раздел("клиенты") конец)
	DOM.на_клик("#вкладка-стадии", функ(_: DOM.СобытиеКлика) -> Пусто переключить_раздел("стадии") конец)
	DOM.на_клик("#добавить-пользователя", функ(_: DOM.СобытиеКлика) -> Пусто обработать_добавить_пользователя() конец)
	DOM.на_клик("#добавить-группу", функ(_: DOM.СобытиеКлика) -> Пусто обработать_добавить_группу() конец)
	DOM.на_клик("#добавить-клиента", функ(_: DOM.СобытиеКлика) -> Пусто обработать_добавить_клиента() конец)
	DOM.на_клик("#ред-польз-сохранить", функ(_: DOM.СобытиеКлика) -> Пусто обработать_сохранить_пользователя() конец)
	DOM.на_клик("#ред-клиент-сохранить", функ(_: DOM.СобытиеКлика) -> Пусто обработать_сохранить_клиента() конец)

	состояние.записать("||")
	показать_логин()
конец
