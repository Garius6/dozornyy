// test_дозорный.pns — e2e-тесты US1+US2+US3: реальный сокет (сервер в
// запусти-процессе на throwaway БД + сеть.http_запрос с клиентской
// стороны того же теста), тот же паттерн, что test_приложение.pns в
// быстряге. Данные (admin/пользователь/клиент) заводятся НАПРЯМУЮ через
// модель.* до спавна сервера (не через bootstrap — тот генерирует
// случайный пароль, недоступный тесту без чтения реального stdout,
// которого panos-скрипту не даёт).

импорт "модули/быстряга/быстряга.pns" как быстряга
импорт "модель.pns" как модель
импорт "пароли.pns" как пароли
импорт "admin.pns" как admin
импорт "oauth.pns" как oauth
импорт бд
импорт "сеть/http" как http
импорт сеть
импорт "кодирование/json" как json
импорт "тест" как т
импорт криптография
импорт строки
импорт время
импорт фс

// http.* (высокоуровневый клиент, std.http.Client из Zig) ПРОЗРАЧНО
// следует за 3xx-редиректами по умолчанию — POST /consent, отправленный
// через http.отправить_пост, приходит клиенту УЖЕ после перехода на
// redirect_uri (обычно 404, т.к. redirect_uri не зарегистрированный
// маршрут), а не как сырой 302 с Location. Для /consent нужен именно
// СЫРОЙ ответ (Location несёт code/error) — сырой сокет (сеть.*) в обход
// авто-следования, единственный способ увидеть его как есть.
тип СыройОтвет = структура
	статус:   Целое
	location: Строка
	тело:     Строка
конец

функ сырой_post(порт: Целое, путь: Строка, тело: Строка) -> Результат(СыройОтвет, Ошибка)
	пер соединение_рез = сеть.подключиться("127.0.0.1", порт)
	если соединение_рез.ошибка() тогда
		возврат Результат.Неудача(соединение_рез.причина())
	конец
	пер с = соединение_рез.значение()
	пер запрос = "POST " + путь + " HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: " + строки.из_целого(длина(тело)) + "\r\nConnection: close\r\n\r\n" + тело
	с.отправить(запрос)
	пер сырой_текст = с.получить().получить("")
	с.закрыть()

	пер части = строки.разбить(сырой_текст, "\r\n\r\n")
	пер заголовки_текст = части.получить(0, "")
	пер тело_ответа = если части.длина() > 1 тогда части.получить(1, "") иначе "" конец
	пер строки_заголовков = строки.разбить(заголовки_текст, "\r\n")
	пер статус_строка = строки_заголовков.получить(0, "")
	пер части_статуса = строки.разбить(статус_строка, " ")
	пер статус = строки.в_число(части_статуса.получить(1, "0")).получить(0.0) как Целое

	пер location = ""
	пер i: Целое = 1
	пока i < строки_заголовков.длина() цикл
		пер строка = строки_заголовков[i]
		если строки.начинается_с(строки.нижний_регистр(строка), "location:") тогда
			location = строки.обрезать(строки.срез(строка, 9, длина(строка)))
		конец
		i = i + 1
	конец

	Результат.Успех(СыройОтвет(статус, location, тело_ответа))
конец

конст ПОРТ = 18790
конст ПУТЬ_БД = "test_дозорный.db"
конст БАЗОВЫЙ_URL = "http://127.0.0.1:18790"

функ извлечь_поле(html: Строка, имя: Строка) -> Опция(Строка)
	пер маркер = "name=\"" + имя + "\" value=\""
	пер начало = строки.найти(html, маркер, 0)
	если начало < 0 тогда
		возврат Опция.Нет()
	конец
	пер значение_начало = начало + длина(маркер)
	пер значение_конец = строки.найти(html, "\"", значение_начало)
	если значение_конец < 0 тогда
		возврат Опция.Нет()
	конец
	Опция.Есть(строки.срез(html, значение_начало, значение_конец))
конец

функ запустить_сервер(соед: Соединение_БД) -> Пусто
	пер секрет_сервера = криптография.случайные_байты_base64url(32)
	пер апи = быстряга.приложение()

	пер (нулевое_тело_пользователь, обработчик_пользователь) = admin.обработчик_создать_пользователя(соед)
	апи.отправить_пост_с("/api/пользователи", admin.извлечь_admin(соед), нулевое_тело_пользователь, обработчик_пользователь)
	апи.получить_с("/api/пользователи", admin.извлечь_admin(соед), admin.обработчик_список_пользователей(соед))
	апи.получить_с("/api/пользователи/:ид", admin.извлечь_admin(соед), admin.обработчик_получить_пользователя(соед))
	пер (нулевое_тело_обн_пользователь, обработчик_обн_пользователь) = admin.обработчик_обновить_пользователя(соед)
	апи.отправить_put_с("/api/пользователи/:ид", admin.извлечь_admin(соед), нулевое_тело_обн_пользователь, обработчик_обн_пользователь)
	апи.удалить_с("/api/пользователи/:ид", admin.извлечь_admin(соед), admin.обработчик_удалить_пользователя(соед))

	пер (нулевое_тело_группа, обработчик_группа) = admin.обработчик_создать_группу(соед)
	апи.отправить_пост_с("/api/группы", admin.извлечь_admin(соед), нулевое_тело_группа, обработчик_группа)
	апи.получить_с("/api/группы", admin.извлечь_admin(соед), admin.обработчик_список_групп(соед))
	апи.удалить_с("/api/группы/:ид", admin.извлечь_admin(соед), admin.обработчик_удалить_группу(соед))
	пер (нулевое_тело_участник, обработчик_участник) = admin.обработчик_добавить_участника(соед)
	апи.отправить_пост_с("/api/участники", admin.извлечь_admin(соед), нулевое_тело_участник, обработчик_участник)

	пер (нулевое_тело_клиент, обработчик_клиент) = admin.обработчик_создать_клиента(соед)
	апи.отправить_пост_с("/api/клиенты", admin.извлечь_admin(соед), нулевое_тело_клиент, обработчик_клиент)
	апи.получить_с("/api/клиенты", admin.извлечь_admin(соед), admin.обработчик_список_клиентов(соед))
	апи.получить_с("/api/клиенты/:client_id", admin.извлечь_admin(соед), admin.обработчик_получить_клиента(соед))
	пер (нулевое_тело_обн_клиент, обработчик_обн_клиент) = admin.обработчик_обновить_клиента(соед)
	апи.отправить_put_с("/api/клиенты/:client_id", admin.извлечь_admin(соед), нулевое_тело_обн_клиент, обработчик_обн_клиент)
	апи.удалить_с("/api/клиенты/:client_id", admin.извлечь_admin(соед), admin.обработчик_удалить_клиента(соед))

	пер (нулевое_тело_вход, обработчик_вход) = admin.обработчик_вход(соед)
	апи.отправить_пост("/api/вход", нулевое_тело_вход, обработчик_вход)

	апи.маршрутизатор.получить("/authorize", функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
		oauth.обработать_authorize(соед, зм)
	конец)
	апи.маршрутизатор.отправить_пост("/login", функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
		oauth.обработать_login(соед, секрет_сервера, зм)
	конец)
	апи.маршрутизатор.отправить_пост("/consent", функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
		oauth.обработать_consent(соед, секрет_сервера, зм)
	конец)
	апи.маршрутизатор.отправить_пост("/token", функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
		oauth.обработать_token(соед, БАЗОВЫЙ_URL, зм)
	конец)
	апи.маршрутизатор.получить("/userinfo", функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
		oauth.обработать_userinfo(соед, зм)
	конец)
	апи.маршрутизатор.получить("/.well-known/openid-configuration", функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
		oauth.обработать_discovery(БАЗОВЫЙ_URL, зм)
	конец)

	апи.запустить(ПОРТ, 1.0)
конец

функ старт() -> Пусто
	пер отчёт = т.новый_отчёт()

	если фс.есть(ПУТЬ_БД) тогда
		фс.удалить(ПУТЬ_БД)
	конец
	пер соед = бд.открыть(ПУТЬ_БД).ожидать("не удалось открыть тестовую БД")
	модель.инициализировать(соед).ожидать("не удалось создать таблицы")

	// admin-пользователь заведён напрямую (не через bootstrap — пароль
	// известен тесту заранее).
	пер хп_admin = пароли.хэшировать("admin-test-пароль")
	модель.создать_пользователя(соед, "admin", хп_admin.хэш, хп_admin.соль, "", истина).ожидать("create admin")
	пер хп_маша = пароли.хэшировать("пароль-маши-123")
	пер ид_маши = модель.создать_пользователя(соед, "маша", хп_маша.хэш, хп_маша.соль, "masha@example.com", ложь).ожидать("create маша")

	пер хс_client = пароли.хэшировать("секрет-тестового-клиента")
	модель.создать_клиента(соед, "test-client", хс_client.хэш, хс_client.соль, "Тестовый клиент", массив(БАЗОВЫЙ_URL + "/cb"), массив("openid", "profile")).ожидать("create client")

	запусти запустить_сервер(соед)
	время.спать_мс(300.0)

	// === US2: admin API ===

	пер вход_рез = http.отправить_пост(БАЗОВЫЙ_URL + "/api/вход", "{\"логин\":\"admin\",\"пароль\":\"admin-test-пароль\"}")
	т.проверить(отчёт, не вход_рез.ошибка(), "US2: POST /api/вход не упал транспортно")
	пер admin_токен = ""
	если не вход_рез.ошибка() тогда
		пер ответ = вход_рез.значение()
		т.равны(отчёт, ответ.статус, 200, "US2: /api/вход -> 200")
		пер тело = json.разобрать(ответ.тело)
		если не тело.ошибка() тогда
			admin_токен = тело.значение().поле("токен").получить(json.Значение.Ноль).как_строку().получить("")
			т.проверить(отчёт, длина(admin_токен) > 0, "US2: /api/вход вернул непустой токен")
		конец
	конец

	пер заголовки_admin: Соответствие(Строка, Строка) = соответствие()
	заголовки_admin["Authorization"] = "Bearer " + admin_токен

	пер список_без_токена = http.запросить(БАЗОВЫЙ_URL + "/api/пользователи")
	если не список_без_токена.ошибка() тогда
		т.равны(отчёт, список_без_токена.значение().статус, 401, "US2 Acceptance 4: /api/пользователи БЕЗ токена -> 401")
	конец

	пер список_рез = http.получить_с_заголовками(БАЗОВЫЙ_URL + "/api/пользователи", заголовки_admin)
	т.проверить(отчёт, не список_рез.ошибка(), "US2: GET /api/пользователи с admin-токеном не упал транспортно")
	если не список_рез.ошибка() тогда
		пер ответ = список_рез.значение()
		т.равны(отчёт, ответ.статус, 200, "US2: GET /api/пользователи -> 200")
		т.проверить(отчёт, не строки.содержит(ответ.тело, "хэш"), "US2 SC-005: список пользователей не содержит поле хэша пароля")
	конец

	пер создание_клиента_рез = http.отправить_пост_с_заголовками(
		БАЗОВЫЙ_URL + "/api/клиенты",
		"{\"имя\":\"E2E-клиент\",\"redirect_uri\":\"" + БАЗОВЫЙ_URL + "/cb2\",\"scope\":\"openid\"}",
		заголовки_admin,
	)
	пер client_id2 = ""
	т.проверить(отчёт, не создание_клиента_рез.ошибка(), "US2: POST /api/клиенты не упал транспортно")
	если не создание_клиента_рез.ошибка() тогда
		пер ответ = создание_клиента_рез.значение()
		т.равны(отчёт, ответ.статус, 201, "US2 Acceptance 3: POST /api/клиенты -> 201")
		пер тело = json.разобрать(ответ.тело)
		если не тело.ошибка() тогда
			т.проверить(отчёт, тело.значение().поле("client_secret").есть(), "US2 Acceptance 3: ответ содержит client_secret РОВНО в этот момент")
			client_id2 = тело.значение().поле("client_id").получить(json.Значение.Ноль).как_строку().получить("")
		конец
	конец
	если длина(client_id2) > 0 тогда
		пер повторный_рез = http.получить_с_заголовками(БАЗОВЫЙ_URL + "/api/клиенты/" + client_id2, заголовки_admin)
		если не повторный_рез.ошибка() тогда
			т.проверить(отчёт, не строки.содержит(повторный_рез.значение().тело, "client_secret"), "US2 Acceptance 3: повторный GET клиента НЕ содержит client_secret")
		конец
	конец

	// FR-010 CRUD: 404 на несуществующий ресурс (не 200 с нулевыми
	// полями) — получить/получить_с в быстряге теперь возвращают
	// быстряга.Отклик(Ответ), как и POST/PUT/DELETE.
	пер отсутствующий_польз_рез = http.получить_с_заголовками(БАЗОВЫЙ_URL + "/api/пользователи/999999", заголовки_admin)
	если не отсутствующий_польз_рез.ошибка() тогда
		т.равны(отчёт, отсутствующий_польз_рез.значение().статус, 404, "FR-010: GET несуществующего пользователя -> 404")
	конец
	пер отсутствующий_клиент_рез = http.получить_с_заголовками(БАЗОВЫЙ_URL + "/api/клиенты/нет-такого-клиента", заголовки_admin)
	если не отсутствующий_клиент_рез.ошибка() тогда
		т.равны(отчёт, отсутствующий_клиент_рез.значение().статус, 404, "FR-010: GET несуществующего клиента -> 404")
	конец

	// FR-010 CRUD: полный цикл create -> update -> delete -> 404.
	пер crud_польз_рез = http.отправить_пост_с_заголовками(БАЗОВЫЙ_URL + "/api/пользователи", "{\"логин\":\"crud-e2e\",\"пароль\":\"parolCrud1\",\"email\":\"a@e.com\"}", заголовки_admin)
	пер crud_ид = ""
	если не crud_польз_рез.ошибка() тогда
		пер тело = json.разобрать(crud_польз_рез.значение().тело)
		если не тело.ошибка() тогда
			crud_ид = строки.из_целого(тело.значение().поле("ид").получить(json.Значение.Ноль).как_число().получить(0.0) как Целое)
		конец
	конец
	если длина(crud_ид) > 0 тогда
		пер обн_рез = http.отправить_put_с_заголовками(БАЗОВЫЙ_URL + "/api/пользователи/" + crud_ид, "{\"email\":\"changed@e.com\",\"активен\":false}", заголовки_admin)
		т.проверить(отчёт, не обн_рез.ошибка(), "FR-010: PUT пользователя не упал транспортно")
		если не обн_рез.ошибка() тогда
			т.равны(отчёт, обн_рез.значение().статус, 200, "FR-010: PUT пользователя -> 200")
			т.проверить(отчёт, строки.содержит(обн_рез.значение().тело, "changed@e.com"), "FR-010: PUT применил изменение email")
		конец
		пер удал_рез = http.удалить_с_заголовками(БАЗОВЫЙ_URL + "/api/пользователи/" + crud_ид, заголовки_admin)
		т.проверить(отчёт, не удал_рез.ошибка(), "FR-010: DELETE пользователя не упал транспортно")
		если не удал_рез.ошибка() тогда
			т.равны(отчёт, удал_рез.значение().статус, 200, "FR-010: DELETE пользователя -> 200")
		конец
		пер после_удаления_рез = http.получить_с_заголовками(БАЗОВЫЙ_URL + "/api/пользователи/" + crud_ид, заголовки_admin)
		если не после_удаления_рез.ошибка() тогда
			т.равны(отчёт, после_удаления_рез.значение().статус, 404, "FR-010: GET удалённого пользователя -> 404")
		конец
	конец

	// === US1: authorization code + PKCE ===

	пер code_verifier = "e2e-test-code-verifier-1234567890abcdefgh"
	пер code_challenge = криптография.sha256_base64url(code_verifier)
	пер redirect_uri = БАЗОВЫЙ_URL + "/cb"

	пер authorize_query: Соответствие(Строка, Строка) = соответствие()
	authorize_query["response_type"] = "code"
	authorize_query["client_id"] = "test-client"
	authorize_query["redirect_uri"] = redirect_uri
	authorize_query["scope"] = "openid profile"
	authorize_query["state"] = "e2e-state"
	authorize_query["code_challenge"] = code_challenge
	authorize_query["code_challenge_method"] = "S256"
	пер authorize_рез = http.запросить(БАЗОВЫЙ_URL + "/authorize" + http.построить_query(authorize_query))
	т.проверить(отчёт, не authorize_рез.ошибка(), "US1: GET /authorize не упал транспортно")
	пер форма_логина = ""
	если не authorize_рез.ошибка() тогда
		пер ответ = authorize_рез.значение()
		т.равны(отчёт, ответ.статус, 200, "US1 Acceptance 1: валидный /authorize -> форма логина (200, не редирект/ошибка)")
		форма_логина = ответ.тело
	конец

	// US1 Acceptance 1: невалидный client_id -> 400 ДО формы логина.
	пер плохой_client_рез = http.запросить(БАЗОВЫЙ_URL + "/authorize?response_type=code&client_id=нет-такого&redirect_uri=x&scope=openid&state=s&code_challenge=x&code_challenge_method=S256")
	если не плохой_client_рез.ошибка() тогда
		т.равны(отчёт, плохой_client_рез.значение().статус, 400, "US1 FR-003: неизвестный client_id -> 400 до формы логина")
	конец

	// US1 Acceptance 2: неверный пароль -> форма логина снова, без сессии.
	пер плохой_логин_поля: Соответствие(Строка, Строка) = соответствие()
	плохой_логин_поля["client_id"] = "test-client"
	плохой_логин_поля["redirect_uri"] = redirect_uri
	плохой_логин_поля["scope"] = "openid profile"
	плохой_логин_поля["state"] = "e2e-state"
	плохой_логин_поля["code_challenge"] = code_challenge
	плохой_логин_поля["code_challenge_method"] = "S256"
	плохой_логин_поля["логин"] = "маша"
	плохой_логин_поля["пароль"] = "неверный-пароль"
	пер плохой_логин_body = http.построить_query(плохой_логин_поля)
	пер плохой_логин_рез = http.отправить_пост(БАЗОВЫЙ_URL + "/login", строки.срез(плохой_логин_body, 1, длина(плохой_логин_body)))
	если не плохой_логин_рез.ошибка() тогда
		пер ответ = плохой_логин_рез.значение()
		т.равны(отчёт, ответ.статус, 200, "US1 Acceptance 2: неверный пароль -> форма логина снова (200)")
		т.проверить(отчёт, строки.содержит(ответ.тело, "form"), "US1 Acceptance 2: тело — снова HTML-форма логина")
	конец

	// Успешный логин.
	пер логин_поля: Соответствие(Строка, Строка) = соответствие()
	логин_поля["client_id"] = "test-client"
	логин_поля["redirect_uri"] = redirect_uri
	логин_поля["scope"] = "openid profile"
	логин_поля["state"] = "e2e-state"
	логин_поля["code_challenge"] = code_challenge
	логин_поля["code_challenge_method"] = "S256"
	логин_поля["логин"] = "маша"
	логин_поля["пароль"] = "пароль-маши-123"
	пер логин_body = http.построить_query(логин_поля)
	пер логин_рез = http.отправить_пост(БАЗОВЫЙ_URL + "/login", строки.срез(логин_body, 1, длина(логин_body)))
	пер login_ticket = ""
	т.проверить(отчёт, не логин_рез.ошибка(), "US1: POST /login (верные креды) не упал транспортно")
	если не логин_рез.ошибка() тогда
		пер ответ = логин_рез.значение()
		т.равны(отчёт, ответ.статус, 200, "US1 Acceptance 3: успешный логин -> экран согласия (200)")
		т.проверить(отчёт, строки.содержит(ответ.тело, "E2E-клиент") или строки.содержит(ответ.тело, "Тестовый клиент"), "US1 Acceptance 3: экран согласия показывает имя приложения")
		пер поле = извлечь_поле(ответ.тело, "login_ticket")
		т.проверить(отчёт, поле.есть(), "US1: экран согласия содержит login_ticket")
		login_ticket = поле.получить("")
	конец

	// US1 Acceptance 4: отказ -> редирект с error=access_denied, БЕЗ code.
	если длина(login_ticket) > 0 тогда
		пер отказ_рез = сырой_post(ПОРТ, "/consent", "login_ticket=" + login_ticket + "&decision=deny")
		если не отказ_рез.ошибка() тогда
			пер ответ = отказ_рез.значение()
			т.равны(отчёт, ответ.статус, 302, "US1 Acceptance 4: отказ -> 302 редирект")
			пер location = ответ.location
			т.проверить(отчёт, строки.содержит(location, "error=access_denied"), "US1 Acceptance 4: редирект содержит error=access_denied")
			т.проверить(отчёт, не строки.содержит(location, "code="), "US1 Acceptance 4: редирект НЕ содержит code")
		конец
	конец

	// Повторный логин для чистого кода (предыдущий login_ticket ещё
	// действителен на allow — но переиспользуем свежий, чтобы избежать
	// путаницы с уже "потраченным" на deny-путь тикетом).
	пер логин_рез2 = http.отправить_пост(БАЗОВЫЙ_URL + "/login", строки.срез(логин_body, 1, длина(логин_body)))
	пер login_ticket2 = ""
	если не логин_рез2.ошибка() тогда
		пер поле = извлечь_поле(логин_рез2.значение().тело, "login_ticket")
		login_ticket2 = поле.получить("")
	конец

	пер код = ""
	если длина(login_ticket2) > 0 тогда
		пер согласие_рез = сырой_post(ПОРТ, "/consent", "login_ticket=" + login_ticket2 + "&decision=allow")
		т.проверить(отчёт, не согласие_рез.ошибка(), "US1 Acceptance 5: POST /consent (allow) не упал транспортно")
		если не согласие_рез.ошибка() тогда
			пер ответ = согласие_рез.значение()
			т.равны(отчёт, ответ.статус, 302, "US1 Acceptance 5: согласие -> 302 редирект")
			пер location = ответ.location
			т.проверить(отчёт, строки.содержит(location, "code="), "US1 Acceptance 5: редирект содержит code")
			т.проверить(отчёт, строки.содержит(location, "state=e2e-state"), "US1: редирект сохраняет исходный state")
			пер query_начало = строки.найти(location, "?", 0)
			если query_начало >= 0 тогда
				пер параметры = http.разобрать_query(строки.срез(location, query_начало + 1, длина(location)))
				код = параметры.получить("code", "")
			конец
		конец
	конец
	т.проверить(отчёт, длина(код) > 0, "US1: получен authorization code")

	пер id_token = ""
	пер access_token = ""
	пер refresh_token = ""
	если длина(код) > 0 тогда
		пер token_поля: Соответствие(Строка, Строка) = соответствие()
		token_поля["grant_type"] = "authorization_code"
		token_поля["code"] = код
		token_поля["redirect_uri"] = redirect_uri
		token_поля["client_id"] = "test-client"
		token_поля["client_secret"] = "секрет-тестового-клиента"
		token_поля["code_verifier"] = code_verifier
		пер token_body = http.построить_query(token_поля)
		пер token_рез = http.отправить_пост(БАЗОВЫЙ_URL + "/token", строки.срез(token_body, 1, длина(token_body)))
		т.проверить(отчёт, не token_рез.ошибка(), "US1 SC-001: POST /token не упал транспортно")
		если не token_рез.ошибка() тогда
			пер ответ = token_рез.значение()
			т.равны(отчёт, ответ.статус, 200, "US1 SC-001: успешный обмен -> 200")
			пер тело = json.разобрать(ответ.тело)
			если не тело.ошибка() тогда
				id_token = тело.значение().поле("id_token").получить(json.Значение.Ноль).как_строку().получить("")
				access_token = тело.значение().поле("access_token").получить(json.Значение.Ноль).как_строку().получить("")
				refresh_token = тело.значение().поле("refresh_token").получить(json.Значение.Ноль).как_строку().получить("")
				т.проверить(отчёт, длина(id_token) > 0, "US1: id_token присутствует")
				т.проверить(отчёт, длина(access_token) > 0, "US1: access_token присутствует")
				т.проверить(отчёт, длина(refresh_token) > 0, "US1: refresh_token присутствует")

				// US1 Acceptance 7: id_token проходит проверку тем же секретом.
				пер claims_рез = jwt_проверить_локально("секрет-тестового-клиента", id_token)
				если не claims_рез.ошибка() тогда
					пер claims = claims_рез.значение()
					т.равны(отчёт, claims.поле("sub").получить(json.Значение.Ноль).как_строку().получить(""), строки.из_целого(ид_маши), "US1 Acceptance 7: id_token.sub == пользователь маши")
					т.равны(отчёт, claims.поле("aud").получить(json.Значение.Ноль).как_строку().получить(""), "test-client", "US1 Acceptance 7: id_token.aud == client_id")
					т.проверить(отчёт, claims.поле("exp").есть(), "US1 Acceptance 7: id_token.exp присутствует")
				конец
			конец
		конец

		// US1 Acceptance 5 (повторно): переиспользование ОДНОГО code -> 400 invalid_grant.
		пер повторный_token_рез = http.отправить_пост(БАЗОВЫЙ_URL + "/token", строки.срез(token_body, 1, длина(token_body)))
		если не повторный_token_рез.ошибка() тогда
			т.равны(отчёт, повторный_token_рез.значение().статус, 400, "US1 SC-002: повторное использование code -> 400")
		конец
	конец

	// US1 Acceptance 6 / SC-003: неверный code_verifier -> 400, токены не выданы.
	пер логин_рез3 = http.отправить_пост(БАЗОВЫЙ_URL + "/login", строки.срез(логин_body, 1, длина(логин_body)))
	пер login_ticket3 = ""
	если не логин_рез3.ошибка() тогда
		login_ticket3 = извлечь_поле(логин_рез3.значение().тело, "login_ticket").получить("")
	конец
	если длина(login_ticket3) > 0 тогда
		пер согласие3_рез = сырой_post(ПОРТ, "/consent", "login_ticket=" + login_ticket3 + "&decision=allow")
		пер код3 = ""
		если не согласие3_рез.ошибка() тогда
			пер location = согласие3_рез.значение().location
			пер query_начало = строки.найти(location, "?", 0)
			если query_начало >= 0 тогда
				код3 = http.разобрать_query(строки.срез(location, query_начало + 1, длина(location))).получить("code", "")
			конец
		конец
		если длина(код3) > 0 тогда
			пер плохой_token_поля: Соответствие(Строка, Строка) = соответствие()
			плохой_token_поля["grant_type"] = "authorization_code"
			плохой_token_поля["code"] = код3
			плохой_token_поля["redirect_uri"] = redirect_uri
			плохой_token_поля["client_id"] = "test-client"
			плохой_token_поля["client_secret"] = "секрет-тестового-клиента"
			плохой_token_поля["code_verifier"] = "совершенно-другой-verifier"
			пер плохой_token_body = http.построить_query(плохой_token_поля)
			пер плохой_token_рез = http.отправить_пост(БАЗОВЫЙ_URL + "/token", строки.срез(плохой_token_body, 1, длина(плохой_token_body)))
			если не плохой_token_рез.ошибка() тогда
				т.равны(отчёт, плохой_token_рез.значение().статус, 400, "US1 SC-003: неверный code_verifier -> 400")
			конец
		конец
	конец

	// GET /userinfo (Bearer access_token).
	если длина(access_token) > 0 тогда
		пер userinfo_заголовки: Соответствие(Строка, Строка) = соответствие()
		userinfo_заголовки["Authorization"] = "Bearer " + access_token
		пер userinfo_рез = http.получить_с_заголовками(БАЗОВЫЙ_URL + "/userinfo", userinfo_заголовки)
		т.проверить(отчёт, не userinfo_рез.ошибка(), "US1 FR-008: GET /userinfo не упал транспортно")
		если не userinfo_рез.ошибка() тогда
			пер ответ = userinfo_рез.значение()
			т.равны(отчёт, ответ.статус, 200, "US1 FR-008: /userinfo -> 200")
			пер тело = json.разобрать(ответ.тело)
			если не тело.ошибка() тогда
				т.равны(отчёт, тело.значение().поле("sub").получить(json.Значение.Ноль).как_строку().получить(""), строки.из_целого(ид_маши), "US1 FR-008: /userinfo.sub == sub из токена")
			конец
		конец
	конец

	пер userinfo_без_токена_рез = http.запросить(БАЗОВЫЙ_URL + "/userinfo")
	если не userinfo_без_токена_рез.ошибка() тогда
		т.равны(отчёт, userinfo_без_токена_рез.значение().статус, 401, "US1: /userinfo без токена -> 401")
	конец

	// === US3: refresh-ротация ===

	если длина(refresh_token) > 0 тогда
		пер refresh_поля: Соответствие(Строка, Строка) = соответствие()
		refresh_поля["grant_type"] = "refresh_token"
		refresh_поля["refresh_token"] = refresh_token
		refresh_поля["client_id"] = "test-client"
		refresh_поля["client_secret"] = "секрет-тестового-клиента"
		пер refresh_body = http.построить_query(refresh_поля)
		пер refresh_рез = http.отправить_пост(БАЗОВЫЙ_URL + "/token", строки.срез(refresh_body, 1, длина(refresh_body)))
		т.проверить(отчёт, не refresh_рез.ошибка(), "US3: POST /token grant_type=refresh_token не упал транспортно")
		пер новый_refresh = ""
		если не refresh_рез.ошибка() тогда
			пер ответ = refresh_рез.значение()
			т.равны(отчёт, ответ.статус, 200, "US3 Acceptance 1: refresh -> 200")
			пер тело = json.разобрать(ответ.тело)
			если не тело.ошибка() тогда
				новый_refresh = тело.значение().поле("refresh_token").получить(json.Значение.Ноль).как_строку().получить("")
				т.не_равны(отчёт, новый_refresh, refresh_token, "US3 Acceptance 1: новый refresh_token отличается от переданного")
			конец
		конец

		// US3 Acceptance 2: повторное использование СТАРОГО refresh_token -> 400.
		пер повторный_refresh_рез = http.отправить_пост(БАЗОВЫЙ_URL + "/token", строки.срез(refresh_body, 1, длина(refresh_body)))
		если не повторный_refresh_рез.ошибка() тогда
			т.равны(отчёт, повторный_refresh_рез.значение().статус, 400, "US3 Acceptance 2: повторное использование старого refresh_token -> 400")
		конец

		// Защита от кражи: НОВЫЙ refresh_token из ротации ТОЖЕ должен быть
		// инвалидирован (вся цепочка отозвана).
		если длина(новый_refresh) > 0 тогда
			пер цепочка_поля: Соответствие(Строка, Строка) = соответствие()
			цепочка_поля["grant_type"] = "refresh_token"
			цепочка_поля["refresh_token"] = новый_refresh
			цепочка_поля["client_id"] = "test-client"
			цепочка_поля["client_secret"] = "секрет-тестового-клиента"
			пер цепочка_body = http.построить_query(цепочка_поля)
			пер цепочка_рез = http.отправить_пост(БАЗОВЫЙ_URL + "/token", строки.срез(цепочка_body, 1, длина(цепочка_body)))
			если не цепочка_рез.ошибка() тогда
				т.равны(отчёт, цепочка_рез.значение().статус, 400, "US3 Acceptance 2: вся цепочка отозвана после кражи (новый токен тоже недействителен)")
			конец
		конец
	конец

	// === discovery ===

	пер discovery_рез = http.запросить(БАЗОВЫЙ_URL + "/.well-known/openid-configuration")
	т.проверить(отчёт, не discovery_рез.ошибка(), "FR-012: GET /.well-known/openid-configuration не упал транспортно")
	если не discovery_рез.ошибка() тогда
		пер ответ = discovery_рез.значение()
		т.равны(отчёт, ответ.статус, 200, "FR-012: discovery -> 200")
		пер тело = json.разобрать(ответ.тело)
		если не тело.ошибка() тогда
			т.проверить(отчёт, тело.значение().поле("issuer").есть(), "FR-012: discovery содержит issuer")
			т.проверить(отчёт, тело.значение().поле("authorization_endpoint").есть(), "FR-012: discovery содержит authorization_endpoint")
			т.проверить(отчёт, тело.значение().поле("token_endpoint").есть(), "FR-012: discovery содержит token_endpoint")
			т.проверить(отчёт, тело.значение().поле("userinfo_endpoint").есть(), "FR-012: discovery содержит userinfo_endpoint")
			т.проверить(отчёт, не тело.значение().поле("jwks_uri").есть(), "Assumptions: discovery БЕЗ jwks_uri (HS256-only)")
		конец
	конец

	т.напечатать_сводку(отчёт)
	если отчёт.провалено > 0 тогда
		паника("test_дозорный.pns: есть провалившиеся проверки")
	конец
конец

// Минимальная локальная проверка JWT (без импорта std/кодирование/jwt —
// избегаем ещё одной зависимости в тесте только ради одной проверки
// подписи; та же логика, что jwt.проверить, но inline).
функ jwt_проверить_локально(секрет: Строка, токен: Строка) -> Результат(json.Значение, Ошибка)
	пер части = строки.разбить(токен, ".")
	если части.длина() <> 3 тогда
		возврат Результат.Неудача(Ошибка("test", "не 3 сегмента"))
	конец
	пер заголовок_b64 = части.получить(0, "")
	пер нагрузка_b64 = части.получить(1, "")
	пер подпись_b64 = части.получить(2, "")
	пер вход_подписи = заголовок_b64 + "." + нагрузка_b64
	пер ожидаемая = криптография.hmac_sha256_base64url(секрет, вход_подписи)
	если не криптография.сравнить_константное_время(ожидаемая, подпись_b64) тогда
		возврат Результат.Неудача(Ошибка("test", "неверная подпись"))
	конец
	пер декодировано = криптография.base64url_декодировать(нагрузка_b64)
	если декодировано.ошибка() тогда
		возврат Результат.Неудача(декодировано.причина())
	конец
	json.разобрать(декодировано.значение())
конец
