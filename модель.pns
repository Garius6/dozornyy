// модель.pns — SQLite-схема + репозитории (Пользователь/Группа/Клиент/
// код/access_token/refresh_token/admin_token). Всё время хранится как
// epoch-миллисекунды Целое (строки.из_целого — не строки.из_числа: та
// уходит в scientific notation выше ~6-7 значащих цифр, epoch ms —
// 13 цифр, см. panos gotchas).

импорт бд
импорт криптография
импорт строки
импорт время
импорт коллекции как кол

экспорт тип Пользователь = структура
	ид:         Целое
	логин:      Строка
	хэш_пароля: Строка
	соль:       Строка
	email:      Строка
	активен:    Булево
	админ:      Булево
конец

экспорт тип Группа = структура
	ид:   Целое
	имя:  Строка
конец

/// `публичный` (RFC 6749 §2.1) — клиент без общего секрета с сервером
/// (SPA/мобильное приложение, не может хранить client_secret). Такой
/// клиент аутентифицируется на /token ТОЛЬКО через PKCE (уже обязателен
/// для всех клиентов), а id_token подписывается СЕРВЕРНЫМ ES256-ключом
/// вместо HS256 по хэш_secret/соль (которые для публичного клиента
/// хранятся пустыми строками, никогда не используются).
экспорт тип Клиент = структура
	client_id:     Строка
	хэш_secret:    Строка
	соль:          Строка
	имя:           Строка
	redirect_uris: Массив(Строка) // пробел-разделённый список в БД
	scopes:        Массив(Строка) // пробел-разделённый список в БД
	публичный:     Булево
конец

экспорт тип КодАвторизации = структура
	код:            Строка
	client_id:      Строка
	redirect_uri:   Строка
	scope:          Строка
	code_challenge: Строка
	sub:            Строка
	истекает_мс:    Целое
	использован:    Булево
конец

экспорт тип RefreshТокен = структура
	токен:       Строка
	цепочка:     Строка
	client_id:   Строка
	sub:         Строка
	scope:       Строка
	истекает_мс: Целое
	использован: Булево
конец

экспорт тип AccessТокен = структура
	токен:       Строка
	client_id:   Строка
	sub:         Строка
	scope:       Строка
	истекает_мс: Целое
конец

/// Упрощённый flow-движок (v1): ФИКСИРОВАННЫЙ каталог типов стадий
/// ("login" — обязательная, всегда первая; "consent" — единственная
/// сегодня отключаемая), не визуальный граф-редактор произвольных
/// стадий/policy-выражений, как в authentik. Админ включает/выключает
/// и переупорядочивает через admin API; oauth.pns на каждом шаге
/// сверяется с этой таблицей (см. `следующая_включённая_стадия`).
экспорт тип Стадия = структура
	ид:       Целое
	вид:      Строка
	порядок:  Целое
	включена: Булево
конец

/// Каталог допустимых типов стадий — единственное место, которое нужно
/// расширить, чтобы завести новый ТИП стадии (сама стадия — просто
/// строка-тег в БД, движок не хранит логику типа отдельно от oauth.pns).
экспорт функ допустимые_типы_стадий() -> Массив(Строка)
	массив("login", "consent")
конец

/// Создаёт все таблицы, если их ещё нет — идемпотентно, безопасно
/// вызывать при каждом старте сервера.
экспорт функ инициализировать(соед: Соединение_БД) -> Результат(Булево, Ошибка)
	пер запросы = массив(
		"CREATE TABLE IF NOT EXISTS пользователи (ид INTEGER PRIMARY KEY AUTOINCREMENT, логин TEXT UNIQUE NOT NULL, хэш_пароля TEXT NOT NULL, соль TEXT NOT NULL, email TEXT NOT NULL DEFAULT '', активен INTEGER NOT NULL DEFAULT 1, админ INTEGER NOT NULL DEFAULT 0)",
		"CREATE TABLE IF NOT EXISTS группы (ид INTEGER PRIMARY KEY AUTOINCREMENT, имя TEXT UNIQUE NOT NULL)",
		"CREATE TABLE IF NOT EXISTS пользователь_группы (пользователь_ид INTEGER NOT NULL, группа_ид INTEGER NOT NULL)",
		"CREATE TABLE IF NOT EXISTS клиенты (client_id TEXT PRIMARY KEY, хэш_secret TEXT NOT NULL, соль TEXT NOT NULL, имя TEXT NOT NULL, redirect_uris TEXT NOT NULL, scopes TEXT NOT NULL, публичный INTEGER NOT NULL DEFAULT 0)",
		"CREATE TABLE IF NOT EXISTS коды (код TEXT PRIMARY KEY, client_id TEXT NOT NULL, redirect_uri TEXT NOT NULL, scope TEXT NOT NULL, code_challenge TEXT NOT NULL, sub TEXT NOT NULL, истекает_мс INTEGER NOT NULL, использован INTEGER NOT NULL DEFAULT 0)",
		"CREATE TABLE IF NOT EXISTS refresh_токены (токен TEXT PRIMARY KEY, цепочка TEXT NOT NULL, client_id TEXT NOT NULL, sub TEXT NOT NULL, scope TEXT NOT NULL, истекает_мс INTEGER NOT NULL, использован INTEGER NOT NULL DEFAULT 0)",
		"CREATE TABLE IF NOT EXISTS access_токены (токен TEXT PRIMARY KEY, client_id TEXT NOT NULL, sub TEXT NOT NULL, scope TEXT NOT NULL, истекает_мс INTEGER NOT NULL)",
		"CREATE TABLE IF NOT EXISTS admin_токены (токен TEXT PRIMARY KEY, sub TEXT NOT NULL, истекает_мс INTEGER NOT NULL)",
		"CREATE TABLE IF NOT EXISTS стадии (ид INTEGER PRIMARY KEY AUTOINCREMENT, тип TEXT UNIQUE NOT NULL, порядок INTEGER NOT NULL, включена INTEGER NOT NULL DEFAULT 1)",
		"CREATE TABLE IF NOT EXISTS ключи_сервера (ид INTEGER PRIMARY KEY, d TEXT NOT NULL, x TEXT NOT NULL, y TEXT NOT NULL)",
	)
	пер i: Целое = 0
	пока i < запросы.длина() цикл
		пер рез = соед.выполнить(запросы[i], массив())
		если рез.ошибка() тогда
			возврат Результат.Неудача(рез.причина())
		конец
		i = i + 1
	конец
	// Миграция для БД, созданных ДО добавления публичных клиентов —
	// `CREATE TABLE IF NOT EXISTS` выше не трогает уже существующую
	// таблицу `клиенты`. Ошибка игнорируется намеренно: единственный
	// ожидаемый исход на уже мигрированной БД — "duplicate column
	// name", не значимая для вызывающего (project не ведёт полноценную
	// схему миграций в v1, см. соседние комментарии в этом файле).
	соед.выполнить("ALTER TABLE клиенты ADD COLUMN публичный INTEGER NOT NULL DEFAULT 0", массив())
	Результат.Успех(истина)
конец

функ ряд_в_пользователя(ряд: Соответствие(Строка, Строка)) -> Пользователь
	Пользователь(
		строки.в_число(ряд.получить("ид", "0")).получить(0.0) как Целое,
		ряд.получить("логин", ""),
		ряд.получить("хэш_пароля", ""),
		ряд.получить("соль", ""),
		ряд.получить("email", ""),
		ряд.получить("активен", "1") == "1",
		ряд.получить("админ", "0") == "1",
	)
конец

/// Список групп, в которых состоит пользователь.
экспорт функ группы_пользователя(соед: Соединение_БД, пользователь_ид: Целое) -> Результат(Массив(Группа), Ошибка)
	пер рез = соед.запрос(
		"SELECT г.ид AS ид, г.имя AS имя FROM группы г JOIN пользователь_группы пг ON пг.группа_ид = г.ид WHERE пг.пользователь_ид = ?",
		массив(строки.из_целого(пользователь_ид)),
	)
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	Результат.Успех(кол.отобразить(рез.значение(), функ(ряд: Соответствие(Строка, Строка)) -> Группа
		Группа(строки.в_число(ряд.получить("ид", "0")).получить(0.0) как Целое, ряд.получить("имя", ""))
	конец))
конец

экспорт функ создать_пользователя(соед: Соединение_БД, логин: Строка, хэш_пароля: Строка, соль: Строка, email: Строка, админ: Булево) -> Результат(Целое, Ошибка)
	пер флаг_админ = если админ тогда "1" иначе "0" конец
	пер рез = соед.выполнить(
		"INSERT INTO пользователи (логин, хэш_пароля, соль, email, активен, админ) VALUES (?, ?, ?, ?, 1, ?)",
		массив(логин, хэш_пароля, соль, email, флаг_админ),
	)
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	пер найден = найти_пользователя_по_логину(соед, логин)
	если найден.ошибка() тогда
		возврат Результат.Неудача(найден.причина())
	конец
	Результат.Успех(найден.значение().ид)
конец

экспорт функ найти_пользователя_по_логину(соед: Соединение_БД, логин: Строка) -> Результат(Пользователь, Ошибка)
	пер рез = соед.запрос("SELECT * FROM пользователи WHERE логин = ?", массив(логин))
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	пер строки_рез = рез.значение()
	если строки_рез.длина() == 0 тогда
		возврат Результат.Неудача(Ошибка("дозорный", "пользователь не найден"))
	конец
	Результат.Успех(ряд_в_пользователя(строки_рез[0]))
конец

экспорт функ найти_пользователя_по_ид(соед: Соединение_БД, ид: Целое) -> Результат(Пользователь, Ошибка)
	пер рез = соед.запрос("SELECT * FROM пользователи WHERE ид = ?", массив(строки.из_целого(ид)))
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	пер строки_рез = рез.значение()
	если строки_рез.длина() == 0 тогда
		возврат Результат.Неудача(Ошибка("дозорный", "пользователь не найден"))
	конец
	Результат.Успех(ряд_в_пользователя(строки_рез[0]))
конец

экспорт функ все_пользователи(соед: Соединение_БД) -> Результат(Массив(Пользователь), Ошибка)
	пер рез = соед.запрос("SELECT * FROM пользователи ORDER BY ид", массив())
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	Результат.Успех(кол.отобразить(рез.значение(), ряд_в_пользователя))
конец

экспорт функ количество_пользователей(соед: Соединение_БД) -> Результат(Целое, Ошибка)
	пер рез = соед.запрос("SELECT COUNT(*) AS n FROM пользователи", массив())
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	Результат.Успех(строки.в_число(рез.значение()[0].получить("n", "0")).получить(0.0) как Целое)
конец

/// Обновляет email и активен — НЕ логин/пароль (те требуют отдельных,
/// более осторожных операций — смена логина ломает существующие
/// refresh/access-токены, привязанные к sub=ид, не к логину, так что это
/// технически безопасно, но пароль-то точно не должен обновляться через
/// голый JSON PUT без повторного хэширования тут же — то есть отдельным
/// путём, не в этом v1).
экспорт функ обновить_пользователя(соед: Соединение_БД, ид: Целое, email: Строка, активен: Булево) -> Результат(Булево, Ошибка)
	пер флаг = если активен тогда "1" иначе "0" конец
	пер рез = соед.выполнить(
		"UPDATE пользователи SET email = ?, активен = ? WHERE ид = ?",
		массив(email, флаг, строки.из_целого(ид)),
	)
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	Результат.Успех(истина)
конец

/// Удаляет пользователя и его членство в группах — НЕ каскадирует на
/// уже выданные токены/коды (те просто перестанут резолвиться в
/// реального пользователя при следующей проверке — userinfo/повторный
/// логин естественно откажут, отдельная фоновая чистка не нужна для v1).
экспорт функ удалить_пользователя(соед: Соединение_БД, ид: Целое) -> Результат(Булево, Ошибка)
	пер ид_текст = строки.из_целого(ид)
	пер рез_членства = соед.выполнить("DELETE FROM пользователь_группы WHERE пользователь_ид = ?", массив(ид_текст))
	если рез_членства.ошибка() тогда
		возврат Результат.Неудача(рез_членства.причина())
	конец
	пер рез = соед.выполнить("DELETE FROM пользователи WHERE ид = ?", массив(ид_текст))
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	Результат.Успех(истина)
конец

экспорт функ создать_группу(соед: Соединение_БД, имя: Строка) -> Результат(Целое, Ошибка)
	пер рез = соед.выполнить("INSERT INTO группы (имя) VALUES (?)", массив(имя))
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	пер найдено = соед.запрос("SELECT ид FROM группы WHERE имя = ?", массив(имя))
	если найдено.ошибка() тогда
		возврат Результат.Неудача(найдено.причина())
	конец
	Результат.Успех(строки.в_число(найдено.значение()[0].получить("ид", "0")).получить(0.0) как Целое)
конец

экспорт функ все_группы(соед: Соединение_БД) -> Результат(Массив(Группа), Ошибка)
	пер рез = соед.запрос("SELECT * FROM группы ORDER BY ид", массив())
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	Результат.Успех(кол.отобразить(рез.значение(), функ(ряд: Соответствие(Строка, Строка)) -> Группа
		Группа(строки.в_число(ряд.получить("ид", "0")).получить(0.0) как Целое, ряд.получить("имя", ""))
	конец))
конец

экспорт функ удалить_группу(соед: Соединение_БД, ид: Целое) -> Результат(Булево, Ошибка)
	пер ид_текст = строки.из_целого(ид)
	пер рез_членства = соед.выполнить("DELETE FROM пользователь_группы WHERE группа_ид = ?", массив(ид_текст))
	если рез_членства.ошибка() тогда
		возврат Результат.Неудача(рез_членства.причина())
	конец
	пер рез = соед.выполнить("DELETE FROM группы WHERE ид = ?", массив(ид_текст))
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	Результат.Успех(истина)
конец

экспорт функ добавить_в_группу(соед: Соединение_БД, пользователь_ид: Целое, группа_ид: Целое) -> Результат(Булево, Ошибка)
	пер рез = соед.выполнить(
		"INSERT INTO пользователь_группы (пользователь_ид, группа_ид) VALUES (?, ?)",
		массив(строки.из_целого(пользователь_ид), строки.из_целого(группа_ид)),
	)
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	Результат.Успех(истина)
конец

функ ряд_в_клиента(ряд: Соответствие(Строка, Строка)) -> Клиент
	Клиент(
		ряд.получить("client_id", ""),
		ряд.получить("хэш_secret", ""),
		ряд.получить("соль", ""),
		ряд.получить("имя", ""),
		кол.отфильтровать(строки.разбить(ряд.получить("redirect_uris", ""), " "), функ(с: Строка) -> Булево длина(с) > 0 конец),
		кол.отфильтровать(строки.разбить(ряд.получить("scopes", ""), " "), функ(с: Строка) -> Булево длина(с) > 0 конец),
		ряд.получить("публичный", "0") == "1",
	)
конец

экспорт функ создать_клиента(соед: Соединение_БД, client_id: Строка, хэш_secret: Строка, соль: Строка, имя: Строка, redirect_uris: Массив(Строка), scopes: Массив(Строка), публичный: Булево) -> Результат(Булево, Ошибка)
	пер флаг = если публичный тогда "1" иначе "0" конец
	пер рез = соед.выполнить(
		"INSERT INTO клиенты (client_id, хэш_secret, соль, имя, redirect_uris, scopes, публичный) VALUES (?, ?, ?, ?, ?, ?, ?)",
		массив(client_id, хэш_secret, соль, имя, строки.соединить(redirect_uris, " "), строки.соединить(scopes, " "), флаг),
	)
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	Результат.Успех(истина)
конец

экспорт функ найти_клиента(соед: Соединение_БД, client_id: Строка) -> Результат(Клиент, Ошибка)
	пер рез = соед.запрос("SELECT * FROM клиенты WHERE client_id = ?", массив(client_id))
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	пер строки_рез = рез.значение()
	если строки_рез.длина() == 0 тогда
		возврат Результат.Неудача(Ошибка("дозорный", "клиент не найден"))
	конец
	Результат.Успех(ряд_в_клиента(строки_рез[0]))
конец

экспорт функ все_клиенты(соед: Соединение_БД) -> Результат(Массив(Клиент), Ошибка)
	пер рез = соед.запрос("SELECT * FROM клиенты ORDER BY client_id", массив())
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	Результат.Успех(кол.отобразить(рез.значение(), ряд_в_клиента))
конец

/// Обновляет имя/redirect_uris/scopes — НЕ client_secret (перевыпуск
/// секрета — отдельная, явно разрушительная операция, которую v1 не
/// предоставляет: обновление секрета через тот же PUT молча
/// инвалидировало бы работающую интеграцию без явного намерения).
экспорт функ обновить_клиента(соед: Соединение_БД, client_id: Строка, имя: Строка, redirect_uris: Массив(Строка), scopes: Массив(Строка)) -> Результат(Булево, Ошибка)
	пер рез = соед.выполнить(
		"UPDATE клиенты SET имя = ?, redirect_uris = ?, scopes = ? WHERE client_id = ?",
		массив(имя, строки.соединить(redirect_uris, " "), строки.соединить(scopes, " "), client_id),
	)
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	Результат.Успех(истина)
конец

экспорт функ удалить_клиента(соед: Соединение_БД, client_id: Строка) -> Результат(Булево, Ошибка)
	пер рез = соед.выполнить("DELETE FROM клиенты WHERE client_id = ?", массив(client_id))
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	Результат.Успех(истина)
конец

экспорт функ сохранить_код(соед: Соединение_БД, код: КодАвторизации) -> Результат(Булево, Ошибка)
	пер рез = соед.выполнить(
		"INSERT INTO коды (код, client_id, redirect_uri, scope, code_challenge, sub, истекает_мс, использован) VALUES (?, ?, ?, ?, ?, ?, ?, 0)",
		массив(код.код, код.client_id, код.redirect_uri, код.scope, код.code_challenge, код.sub, строки.из_целого(код.истекает_мс)),
	)
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	Результат.Успех(истина)
конец

функ ряд_в_код(ряд: Соответствие(Строка, Строка)) -> КодАвторизации
	КодАвторизации(
		ряд.получить("код", ""),
		ряд.получить("client_id", ""),
		ряд.получить("redirect_uri", ""),
		ряд.получить("scope", ""),
		ряд.получить("code_challenge", ""),
		ряд.получить("sub", ""),
		строки.в_число(ряд.получить("истекает_мс", "0")).получить(0.0) как Целое,
		ряд.получить("использован", "0") == "1",
	)
конец

экспорт функ найти_код(соед: Соединение_БД, код: Строка) -> Результат(КодАвторизации, Ошибка)
	пер рез = соед.запрос("SELECT * FROM коды WHERE код = ?", массив(код))
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	пер строки_рез = рез.значение()
	если строки_рез.длина() == 0 тогда
		возврат Результат.Неудача(Ошибка("дозорный", "код не найден"))
	конец
	Результат.Успех(ряд_в_код(строки_рез[0]))
конец

экспорт функ пометить_код_использованным(соед: Соединение_БД, код: Строка) -> Результат(Булево, Ошибка)
	пер рез = соед.выполнить("UPDATE коды SET использован = 1 WHERE код = ?", массив(код))
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	Результат.Успех(истина)
конец

экспорт функ сохранить_access_токен(соед: Соединение_БД, токен: AccessТокен) -> Результат(Булево, Ошибка)
	пер рез = соед.выполнить(
		"INSERT INTO access_токены (токен, client_id, sub, scope, истекает_мс) VALUES (?, ?, ?, ?, ?)",
		массив(токен.токен, токен.client_id, токен.sub, токен.scope, строки.из_целого(токен.истекает_мс)),
	)
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	Результат.Успех(истина)
конец

экспорт функ найти_access_токен(соед: Соединение_БД, токен: Строка) -> Результат(AccessТокен, Ошибка)
	пер рез = соед.запрос("SELECT * FROM access_токены WHERE токен = ?", массив(токен))
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	пер строки_рез = рез.значение()
	если строки_рез.длина() == 0 тогда
		возврат Результат.Неудача(Ошибка("дозорный", "токен не найден"))
	конец
	пер ряд = строки_рез[0]
	Результат.Успех(AccessТокен(
		ряд.получить("токен", ""),
		ряд.получить("client_id", ""),
		ряд.получить("sub", ""),
		ряд.получить("scope", ""),
		строки.в_число(ряд.получить("истекает_мс", "0")).получить(0.0) как Целое,
	))
конец

экспорт функ сохранить_refresh_токен(соед: Соединение_БД, токен: RefreshТокен) -> Результат(Булево, Ошибка)
	пер рез = соед.выполнить(
		"INSERT INTO refresh_токены (токен, цепочка, client_id, sub, scope, истекает_мс, использован) VALUES (?, ?, ?, ?, ?, ?, 0)",
		массив(токен.токен, токен.цепочка, токен.client_id, токен.sub, токен.scope, строки.из_целого(токен.истекает_мс)),
	)
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	Результат.Успех(истина)
конец

функ ряд_в_refresh(ряд: Соответствие(Строка, Строка)) -> RefreshТокен
	RefreshТокен(
		ряд.получить("токен", ""),
		ряд.получить("цепочка", ""),
		ряд.получить("client_id", ""),
		ряд.получить("sub", ""),
		ряд.получить("scope", ""),
		строки.в_число(ряд.получить("истекает_мс", "0")).получить(0.0) как Целое,
		ряд.получить("использован", "0") == "1",
	)
конец

экспорт функ найти_refresh_токен(соед: Соединение_БД, токен: Строка) -> Результат(RefreshТокен, Ошибка)
	пер рез = соед.запрос("SELECT * FROM refresh_токены WHERE токен = ?", массив(токен))
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	пер строки_рез = рез.значение()
	если строки_рез.длина() == 0 тогда
		возврат Результат.Неудача(Ошибка("дозорный", "refresh-токен не найден"))
	конец
	Результат.Успех(ряд_в_refresh(строки_рез[0]))
конец

экспорт функ пометить_refresh_использованным(соед: Соединение_БД, токен: Строка) -> Результат(Булево, Ошибка)
	пер рез = соед.выполнить("UPDATE refresh_токены SET использован = 1 WHERE токен = ?", массив(токен))
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	Результат.Успех(истина)
конец

/// Инвалидирует ВСЮ цепочку ротации (защита от повторного использования
/// украденного refresh-токена — RFC 6819 §5.2.2.3).
экспорт функ инвалидировать_цепочку(соед: Соединение_БД, цепочка: Строка) -> Результат(Булево, Ошибка)
	пер рез = соед.выполнить("UPDATE refresh_токены SET использован = 1 WHERE цепочка = ?", массив(цепочка))
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	Результат.Успех(истина)
конец

экспорт функ сохранить_admin_токен(соед: Соединение_БД, токен: Строка, sub: Строка, истекает_мс: Целое) -> Результат(Булево, Ошибка)
	пер рез = соед.выполнить(
		"INSERT INTO admin_токены (токен, sub, истекает_мс) VALUES (?, ?, ?)",
		массив(токен, sub, строки.из_целого(истекает_мс)),
	)
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	Результат.Успех(истина)
конец

экспорт функ проверить_admin_токен(соед: Соединение_БД, токен: Строка) -> Результат(Строка, Ошибка)
	пер рез = соед.запрос("SELECT * FROM admin_токены WHERE токен = ?", массив(токен))
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	пер строки_рез = рез.значение()
	если строки_рез.длина() == 0 тогда
		возврат Результат.Неудача(Ошибка("дозорный", "admin-токен не найден"))
	конец
	пер ряд = строки_рез[0]
	пер истекает_мс = строки.в_число(ряд.получить("истекает_мс", "0")).получить(0.0) как Целое
	если (время.сейчас_мс() как Целое) > истекает_мс тогда
		возврат Результат.Неудача(Ошибка("дозорный", "admin-токен истёк"))
	конец
	Результат.Успех(ряд.получить("sub", ""))
конец

/// Единственная строка (ид=1) с ES256-ключом сервера, используемым
/// для подписи id_token публичных клиентов (`Клиент.публичный`) и для
/// `/.well-known/jwks.json`. Генерируется РОВНО ОДИН РАЗ, при первом
/// обращении — `криптография.es256_сгенерировать_ключи()` и сохраняется,
/// последующие вызовы всегда читают ту же тройку (иначе уже выданные
/// id_token переставали бы проверяться после каждого рестарта).
экспорт функ получить_или_создать_ключи_сервера(соед: Соединение_БД) -> Результат((Строка, Строка, Строка), Ошибка)
	пер рез = соед.запрос("SELECT d, x, y FROM ключи_сервера WHERE ид = 1", массив())
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	пер строки_рез = рез.значение()
	если строки_рез.длина() > 0 тогда
		пер ряд = строки_рез[0]
		возврат Результат.Успех((ряд.получить("d", ""), ряд.получить("x", ""), ряд.получить("y", "")))
	конец

	пер ключи = криптография.es256_сгенерировать_ключи()
	пер вставка = соед.выполнить(
		"INSERT INTO ключи_сервера (ид, d, x, y) VALUES (1, ?, ?, ?)",
		массив(ключи.0, ключи.1, ключи.2),
	)
	если вставка.ошибка() тогда
		// Гонка: два запроса ОДНОВРЕМЕННО увидели пустую таблицу (SELECT
		// выше suspend'ится на async-воркере, планировщик может
		// переключиться на другой процесс между SELECT и INSERT) —
		// UNIQUE(ид=1) отклоняет второй INSERT. Самоисцеляется —
		// перечитываем строку, которую успел вставить первый; жёсткая
		// ошибка только если это НЕ гонка (реальная проблема БД).
		пер повтор = соед.запрос("SELECT d, x, y FROM ключи_сервера WHERE ид = 1", массив())
		если повтор.ошибка() или повтор.значение().длина() == 0 тогда
			возврат Результат.Неудача(вставка.причина())
		конец
		пер ряд = повтор.значение()[0]
		возврат Результат.Успех((ряд.получить("d", ""), ряд.получить("x", ""), ряд.получить("y", "")))
	конец
	Результат.Успех(ключи)
конец

функ ряд_в_стадию(ряд: Соответствие(Строка, Строка)) -> Стадия
	Стадия(
		строки.в_число(ряд.получить("ид", "0")).получить(0.0) как Целое,
		ряд.получить("тип", ""),
		строки.в_число(ряд.получить("порядок", "0")).получить(0.0) как Целое,
		ряд.получить("включена", "1") == "1",
	)
конец

/// Пустая таблица стадий -> дефолтный порядок (login, затем consent),
/// обе включены — совпадает с жёстким поведением до появления
/// flow-движка (см. историю oauth.pns), так что апгрейд БД с более
/// ранней версии дозорного ничего не меняет в поведении по умолчанию.
экспорт функ засеять_стадии_по_умолчанию(соед: Соединение_БД) -> Результат(Булево, Ошибка)
	пер рез = соед.запрос("SELECT COUNT(*) AS n FROM стадии", массив())
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	если строки.в_число(рез.значение()[0].получить("n", "0")).получить(0.0) <> 0.0 тогда
		возврат Результат.Успех(ложь)
	конец
	пер вставка_login = соед.выполнить("INSERT INTO стадии (тип, порядок, включена) VALUES ('login', 0, 1)", массив())
	если вставка_login.ошибка() тогда
		возврат Результат.Неудача(вставка_login.причина())
	конец
	пер вставка_consent = соед.выполнить("INSERT INTO стадии (тип, порядок, включена) VALUES ('consent', 1, 1)", массив())
	если вставка_consent.ошибка() тогда
		возврат Результат.Неудача(вставка_consent.причина())
	конец
	Результат.Успех(истина)
конец

/// Все стадии, отсортированные по порядку выполнения.
экспорт функ все_стадии(соед: Соединение_БД) -> Результат(Массив(Стадия), Ошибка)
	пер рез = соед.запрос("SELECT * FROM стадии ORDER BY порядок", массив())
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	Результат.Успех(кол.отобразить(рез.значение(), ряд_в_стадию))
конец

/// Включена ли стадия данного типа — false и для отсутствующей строки
/// (тип не в таблице), и для явно выключенной (включена=0). oauth.pns
/// использует это для условного пропуска шага (сегодня — только
/// consent), а не для полного описания порядка (login всегда первый и
/// обязательный по построению самого HTTP-флоу, не из этой таблицы).
экспорт функ стадия_включена(соед: Соединение_БД, вид: Строка) -> Результат(Булево, Ошибка)
	пер рез = соед.запрос("SELECT включена FROM стадии WHERE тип = ?", массив(вид))
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец
	пер строки_рез = рез.значение()
	если строки_рез.длина() == 0 тогда
		возврат Результат.Успех(ложь)
	конец
	Результат.Успех(строки_рез[0].получить("включена", "0") == "1")
конец

/// Полная замена набора стадий — весь список приходит от admin API
/// разом (переупорядочивание — операция над ЦЕЛЫМ списком, не над
/// одной записью). ВСЕГДА добавляет обязательную 'login' стадию первой
/// (порядок 0, включена), даже если её не было во входном массиве —
/// её отключение сделало бы аутентификацию невозможной.
экспорт функ заменить_стадии(соед: Соединение_БД, стадии: Массив(Стадия)) -> Результат(Булево, Ошибка)
	пер очистка = соед.выполнить("DELETE FROM стадии", массив())
	если очистка.ошибка() тогда
		возврат Результат.Неудача(очистка.причина())
	конец
	пер вставка_login = соед.выполнить("INSERT INTO стадии (тип, порядок, включена) VALUES ('login', 0, 1)", массив())
	если вставка_login.ошибка() тогда
		возврат Результат.Неудача(вставка_login.причина())
	конец
	пер i: Целое = 0
	пока i < стадии.длина() цикл
		пер с = стадии[i]
		если с.вид <> "login" тогда
			пер флаг = если с.включена тогда "1" иначе "0" конец
			пер рез = соед.выполнить(
				"INSERT INTO стадии (тип, порядок, включена) VALUES (?, ?, ?)",
				массив(с.вид, строки.из_целого(i + 1), флаг),
			)
			если рез.ошибка() тогда
				возврат Результат.Неудача(рез.причина())
			конец
		конец
		i = i + 1
	конец
	Результат.Успех(истина)
конец
