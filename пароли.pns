// пароли.pns — хэширование/проверка паролей поверх
// криптография.pbkdf2_sha256_base64url (медленный KDF — HMAC-SHA256
// напрямую НЕ годится для паролей, см. spec.md "Криптографические
// предпосылки"). Соль — на пользователя, случайная
// (криптография.случайные_байты_base64url), НИКОГДА не переиспользуется.

импорт криптография

/// Число итераций PBKDF2 — фиксированное для v1 (не настраиваемое per-
/// пользователь), достаточно медленное для offline brute-force защиты
/// без заметной задержки на логин (~десятки мс).
экспорт конст ИТЕРАЦИИ = 100000.0

экспорт тип ХэшПароля = структура
	хэш: Строка
	соль: Строка
конец

/// Генерирует новую случайную соль и хэширует пароль поверх неё.
экспорт функ хэшировать(пароль: Строка) -> ХэшПароля
	пер соль = криптография.случайные_байты_base64url(16)
	ХэшПароля(криптография.pbkdf2_sha256_base64url(пароль, соль, ИТЕРАЦИИ), соль)
конец

/// Пересчитывает хэш с СОХРАНЁННОЙ солью и сравнивает константным
/// временем — обычное `==` дало бы byte-by-byte тайминг-оракул.
экспорт функ проверить(пароль: Строка, хэш: Строка, соль: Строка) -> Булево
	пер пересчитанный = криптография.pbkdf2_sha256_base64url(пароль, соль, ИТЕРАЦИИ)
	криптография.сравнить_константное_время(пересчитанный, хэш)
конец
