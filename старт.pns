// старт.pns — точка входа: инициализация БД, bootstrap admin-пользователя
// (FR-011), регистрация admin API (US2, быстряга.Приложение — JSON) и
// OAuth2/OIDC-маршрутов (US1/US3, сырой http.Маршрутизатор — HTML-формы
// и редиректы) на ОДНОМ Маршрутизаторе/порту.
//
// ВАЖНО про инлайн-обёртки ниже: быстряга-generic-методы (отправить_пост_с
// /получить_с) с bound-параметром (Тело: ТелоJSON+Валидируемое, Ответ:
// ОтветJSON) не выводят generic-параметр, если аргумент — функция/
// замыкание, ПОЛУЧЕННОЕ ИЗ ДРУГОГО МОДУЛЯ (именованная функция ИЛИ
// замыкание, возвращённое другой функцией — без разницы) — "не удалось
// вывести type-параметр". Подтверждённый воспроизводимый баг тайпчекера
// (не архитектурная особенность дозорного) — минимальный репро с 3
// файлами (интерфейс/impl/generic-метод в разных модулях) даёт ту же
// ошибку; НЕ баг, если аргумент — inline-лямбда, ОБЪЯВЛЕННАЯ ПРЯМО В
// ЭТОМ модуле (даже если внутри делегирует в другой модуль) — тонкая
// инлайн-обёртка вокруг admin.* ниже это и есть, обходной путь на
// уровне вызова, а не переписывание логики; корневая причина — в
// zig/core/type_checker.zig (inferGenericSubstitution/.nominal-ветка,
// подозрение на расхождение Symbol_Id для одного и того же nominal-типа,
// вида reexport vs прямое обращение) остаётся открытой для отдельной
// сессии. Параметр Данные (без interface-bound, только у extract) баг
// НЕ затрагивает — admin.извлечь_admin(соед) передаётся напрямую.

импорт "модули/быстряга/быстряга.pns" как быстряга
импорт "модель.pns" как модель
импорт "пароли.pns" как пароли
импорт "admin.pns" как admin
импорт "oauth.pns" как oauth
импорт бд
импорт "сеть/http" как http
импорт "кодирование/json" как json
импорт криптография
импорт ввод_вывод

/// Пустая БД (таблица пользователей) -> ровно один admin со случайным
/// паролем, напечатанным В ЛОГ РОВНО ОДИН РАЗ при старте (FR-011 — не
/// хардкодить admin/admin).
функ bootstrap_admin(соед: Соединение_БД) -> Результат(Булево, Ошибка)
	пер количество_рез = модель.количество_пользователей(соед)
	если количество_рез.ошибка() тогда
		возврат Результат.Неудача(количество_рез.причина())
	конец
	если количество_рез.значение() > 0 тогда
		возврат Результат.Успех(ложь)
	конец
	пер пароль = криптография.случайные_байты_base64url(12)
	пер хп = пароли.хэшировать(пароль)
	пер создание = модель.создать_пользователя(соед, "admin", хп.хэш, хп.соль, "", истина)
	если создание.ошибка() тогда
		возврат Результат.Неудача(создание.причина())
	конец
	ввод_вывод.строка("=== bootstrap: создан администратор ===")
	ввод_вывод.строка("логин: admin")
	ввод_вывод.строка("пароль: " + пароль)
	ввод_вывод.строка("(этот пароль напечатан ЕДИНСТВЕННЫЙ раз — сохраните его)")
	Результат.Успех(истина)
конец

// Порт/путь БД/базовый URL — фиксированные константы в v1 (нет CLI-флагов
// — дозорный не заявлял их в спеке; переменные окружения тоже не
// обёрнуты ни в одном std-модуле panos сегодня). Смена — правка этих
// трёх строк перед сборкой, тот же уровень "конфигурации", что был бы у
// docker-compose-переменных без реального ENV-чтения.
конст ПОРТ = 8080
конст ПУТЬ_БД = "дозорный.db"
конст БАЗОВЫЙ_URL = "http://127.0.0.1:8080"

функ старт() -> Результат(Число, Ошибка)
	пер соед = бд.открыть(ПУТЬ_БД).ожидать("не удалось открыть БД")
	модель.инициализировать(соед).ожидать("не удалось создать таблицы")
	bootstrap_admin(соед).ожидать("не удалось создать администратора")

	// Секрет тикета логин->согласие — генерируется заново при КАЖДОМ
	// старте сервера (живёт только в памяти этого процесса, closures
	// ниже — единственный носитель; top-level мутируемого состояния в
	// panos нет). Незавершённые login_ticket переживают рестарт сервера
	// некорректно (подпись перестаёт совпадать) — приемлемо: тикет живёт
	// секунды между /login и /consent в РУЧНОМ интерактивном флоу,
	// рестарт сервера прямо в эти секунды — не сценарий, который стоит
	// усложнять ради него постоянное хранение секрета.
	пер секрет_сервера = криптография.случайные_байты_base64url(32)

	пер апи = быстряга.приложение()

	пер (нулевое_тело_пользователь, обработчик_пользователь) = admin.обработчик_создать_пользователя(соед)
	апи.отправить_пост_с(
		"/api/пользователи",
		admin.извлечь_admin(соед),
		функ() -> admin.ВходПользователь нулевое_тело_пользователь() конец,
		функ(sub: Строка, вход: admin.ВходПользователь) -> быстряга.Отклик(admin.ОтветПользователь) обработчик_пользователь(sub, вход) конец,
	)
	пер список_пользователей_ф = admin.обработчик_список_пользователей(соед)
	апи.получить_с("/api/пользователи", admin.извлечь_admin(соед),
		функ(зм: http.ЗапросМаршрута, sub: Строка) -> admin.ОтветПользователи список_пользователей_ф(зм, sub) конец)
	пер получить_пользователя_ф = admin.обработчик_получить_пользователя(соед)
	апи.получить_с("/api/пользователи/:ид", admin.извлечь_admin(соед),
		функ(зм: http.ЗапросМаршрута, sub: Строка) -> admin.ОтветПользователь получить_пользователя_ф(зм, sub) конец)

	пер (нулевое_тело_группа, обработчик_группа) = admin.обработчик_создать_группу(соед)
	апи.отправить_пост_с(
		"/api/группы",
		admin.извлечь_admin(соед),
		функ() -> admin.ВходГруппа нулевое_тело_группа() конец,
		функ(sub: Строка, вход: admin.ВходГруппа) -> быстряга.Отклик(admin.ОтветГруппа) обработчик_группа(sub, вход) конец,
	)
	пер список_групп_ф = admin.обработчик_список_групп(соед)
	апи.получить_с("/api/группы", admin.извлечь_admin(соед),
		функ(зм: http.ЗапросМаршрута, sub: Строка) -> admin.ОтветГруппы список_групп_ф(зм, sub) конец)

	пер (нулевое_тело_участник, обработчик_участник) = admin.обработчик_добавить_участника(соед)
	апи.отправить_пост_с(
		"/api/участники",
		admin.извлечь_admin(соед),
		функ() -> admin.ВходУчастник нулевое_тело_участник() конец,
		функ(sub: Строка, вход: admin.ВходУчастник) -> быстряга.Отклик(admin.ОтветПусто) обработчик_участник(sub, вход) конец,
	)

	пер (нулевое_тело_клиент, обработчик_клиент) = admin.обработчик_создать_клиента(соед)
	апи.отправить_пост_с(
		"/api/клиенты",
		admin.извлечь_admin(соед),
		функ() -> admin.ВходКлиент нулевое_тело_клиент() конец,
		функ(sub: Строка, вход: admin.ВходКлиент) -> быстряга.Отклик(admin.ОтветКлиентСоздан) обработчик_клиент(sub, вход) конец,
	)
	пер список_клиентов_ф = admin.обработчик_список_клиентов(соед)
	апи.получить_с("/api/клиенты", admin.извлечь_admin(соед),
		функ(зм: http.ЗапросМаршрута, sub: Строка) -> admin.ОтветКлиенты список_клиентов_ф(зм, sub) конец)
	пер получить_клиента_ф = admin.обработчик_получить_клиента(соед)
	апи.получить_с("/api/клиенты/:client_id", admin.извлечь_admin(соед),
		функ(зм: http.ЗапросМаршрута, sub: Строка) -> admin.ОтветКлиент получить_клиента_ф(зм, sub) конец)

	пер (нулевое_тело_вход, обработчик_вход) = admin.обработчик_вход(соед)
	апи.отправить_пост(
		"/api/вход",
		функ() -> admin.ВходЛогин нулевое_тело_вход() конец,
		функ(вход: admin.ВходЛогин) -> быстряга.Отклик(admin.ОтветВход) обработчик_вход(вход) конец,
	)

	апи.маршрутизатор.получить("/authorize", функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
		oauth.обработать_authorize(соед, зм)
	конец)
	апи.маршрутизатор.отправить_пост("/login", функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
		oauth.обработать_login(соед, секрет_сервера, зм)
	конец)
	апи.маршрутизатор.отправить_пост("/consent", функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
		oauth.обработать_consent(соед, секрет_сервера, зм)
	конец)
	апи.маршрутизатор.отправить_пост("/token", функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
		oauth.обработать_token(соед, БАЗОВЫЙ_URL, зм)
	конец)
	апи.маршрутизатор.получить("/userinfo", функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
		oauth.обработать_userinfo(соед, зм)
	конец)
	апи.маршрутизатор.получить("/.well-known/openid-configuration", функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
		oauth.обработать_discovery(БАЗОВЫЙ_URL, зм)
	конец)

	ввод_вывод.строка("дозорный слушает " + БАЗОВЫЙ_URL)
	апи.запустить(ПОРТ, 1.0)
конец
