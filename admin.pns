// admin.pns — REST/JSON admin API (US2) поверх быстряга.Приложение —
// типизированный слой (авто-разбор/валидация/сериализация JSON)
// подходит здесь идеально, в отличие от oauth.pns (HTML-формы,
// редиректы), поэтому админка НЕ разделяет Маршрутизатор с oauth.pns —
// у обоих свой независимый набор путей на одном порту (см. старт.pns,
// оба регистрируются на одном http.обслуживать через быстряга.
// Приложение.маршрутизатор — сырые пути и типизированные сосуществуют
// на одном Маршрутизаторе без конфликта).

импорт "модули/быстряга/быстряга.pns" как быстряга
импорт "модель.pns" как модель
импорт "пароли.pns" как пароли
импорт "кодирование/json" как json
импорт "сеть/http" как http
импорт строки
импорт время
импорт криптография
импорт коллекции как кол

конст TTL_ADMIN_ТОКЕНА_МС = 900000.0 // 15 минут — короче обычного access_token (FR-010)

/// Extractor для admin-защищённых маршрутов — Authorization: Bearer
/// <admin-токен>, проверенный по admin_токены (FR-010: ЛЮБОЙ /api/*
/// без него — 401, не 500).
экспорт функ извлечь_admin(соед: Соединение_БД) -> функ(Запрос) -> Результат(Строка, Ошибка)
	функ(зпр: Запрос) -> Результат(Строка, Ошибка)
		пер заголовок = зпр.заголовок("Authorization").получить("")
		если не строки.начинается_с(заголовок, "Bearer ") тогда
			возврат Результат.Неудача(Ошибка("дозорный", "нужен Authorization: Bearer <admin-токен>"))
		конец
		пер токен = строки.срез(заголовок, 7, длина(заголовок))
		модель.проверить_admin_токен(соед, токен)
	конец
конец

// --- POST /api/вход ---

экспорт тип ВходЛогин = структура
	логин:  Строка
	пароль: Строка
конец

реализация быстряга.ТелоJSON для ВходЛогин
	функ заполнить_из_json(это: ВходЛогин, значение: json.Значение) -> Опция(Ошибка)
		это.логин = значение.поле("логин").получить(json.Значение.Ноль).как_строку().получить("")
		это.пароль = значение.поле("пароль").получить(json.Значение.Ноль).как_строку().получить("")
		Опция.Нет()
	конец
конец

реализация быстряга.Валидируемое для ВходЛогин
	функ проверить(это: ВходЛогин) -> Опция(Строка)
		если длина(это.логин) == 0 или длина(это.пароль) == 0 тогда
			возврат Опция.Есть("логин и пароль обязательны")
		конец
		Опция.Нет()
	конец
конец

экспорт тип ОтветВход = структура
	токен: Строка
конец

реализация быстряга.ОтветJSON для ОтветВход
	функ в_json(это: ОтветВход) -> json.Значение
		json.объект(массив(("токен", json.Значение.Строка(это.токен))))
	конец
конец

/// POST /api/вход — админ логинится через СВОЙ отдельный вход (не
/// обычный OAuth2 access_token), получает admin-токен с более коротким
/// TTL (FR-010).
экспорт функ обработчик_вход(соед: Соединение_БД) -> (функ() -> ВходЛогин, функ(ВходЛогин) -> быстряга.Отклик(ОтветВход))
	пер нулевое_тело = функ() -> ВходЛогин ВходЛогин("", "") конец
	пер обработчик = функ(вход: ВходЛогин) -> быстряга.Отклик(ОтветВход)
		пер пользователь_рез = модель.найти_пользователя_по_логину(соед, вход.логин)
		если пользователь_рез.ошибка() или не пользователь_рез.значение().админ тогда
			возврат быстряга.Отклик(401, ОтветВход(""))
		конец
		пер пользователь = пользователь_рез.значение()
		если не пользователь.активен или не пароли.проверить(вход.пароль, пользователь.хэш_пароля, пользователь.соль) тогда
			возврат быстряга.Отклик(401, ОтветВход(""))
		конец
		пер токен = криптография.случайные_байты_base64url(32)
		пер истекает_мс = (время.сейчас_мс() как Целое) + (TTL_ADMIN_ТОКЕНА_МС как Целое)
		модель.сохранить_admin_токен(соед, токен, строки.из_целого(пользователь.ид), истекает_мс).ожидать("сохранить admin-токен")
		быстряга.Отклик(200, ОтветВход(токен))
	конец
	(нулевое_тело, обработчик)
конец

// --- /api/пользователи ---

экспорт тип ВходПользователь = структура
	логин:  Строка
	пароль: Строка
	email:  Строка
конец

реализация быстряга.ТелоJSON для ВходПользователь
	функ заполнить_из_json(это: ВходПользователь, значение: json.Значение) -> Опция(Ошибка)
		это.логин = значение.поле("логин").получить(json.Значение.Ноль).как_строку().получить("")
		это.пароль = значение.поле("пароль").получить(json.Значение.Ноль).как_строку().получить("")
		это.email = значение.поле("email").получить(json.Значение.Ноль).как_строку().получить("")
		Опция.Нет()
	конец
конец

реализация быстряга.Валидируемое для ВходПользователь
	функ проверить(это: ВходПользователь) -> Опция(Строка)
		если длина(это.логин) == 0 тогда
			возврат Опция.Есть("логин обязателен")
		конец
		если длина(это.пароль) == 0 тогда
			возврат Опция.Есть("пароль обязателен")
		конец
		Опция.Нет()
	конец
конец

/// Публичное представление пользователя — ПОЛЕЙ хэш_пароля/соль здесь
/// НЕТ ни в каком виде (SC-005, Acceptance Scenario 1).
экспорт тип ОтветПользователь = структура
	ид:      Целое
	логин:   Строка
	email:   Строка
	активен: Булево
	группы:  Массив(Строка)
конец

реализация быстряга.ОтветJSON для ОтветПользователь
	функ в_json(это: ОтветПользователь) -> json.Значение
		json.объект(массив(
			("ид", json.Значение.Число(это.ид как Число)),
			("логин", json.Значение.Строка(это.логин)),
			("email", json.Значение.Строка(это.email)),
			("активен", json.Значение.Булево(это.активен)),
			("группы", json.Значение.Список(кол.отобразить(это.группы, функ(имя: Строка) -> json.Значение json.Значение.Строка(имя) конец))),
		))
	конец
конец

экспорт тип ОтветПользователи = структура
	элементы: Массив(ОтветПользователь)
конец

реализация быстряга.ОтветJSON для ОтветПользователи
	функ в_json(это: ОтветПользователи) -> json.Значение
		json.Значение.Список(кол.отобразить(это.элементы, функ(п: ОтветПользователь) -> json.Значение п.в_json() конец))
	конец
конец

функ пользователь_в_ответ(соед: Соединение_БД, п: модель.Пользователь) -> ОтветПользователь
	пер группы = модель.группы_пользователя(соед, п.ид).получить(массив())
	ОтветПользователь(п.ид, п.логин, п.email, п.активен, кол.отобразить(группы, функ(г: модель.Группа) -> Строка г.имя конец))
конец

экспорт функ обработчик_создать_пользователя(соед: Соединение_БД) -> (функ() -> ВходПользователь, функ(Строка, ВходПользователь) -> быстряга.Отклик(ОтветПользователь))
	пер нулевое_тело = функ() -> ВходПользователь ВходПользователь("", "", "") конец
	пер обработчик = функ(_admin: Строка, вход: ВходПользователь) -> быстряга.Отклик(ОтветПользователь)
		пер хп = пароли.хэшировать(вход.пароль)
		пер ид_рез = модель.создать_пользователя(соед, вход.логин, хп.хэш, хп.соль, вход.email, ложь)
		если ид_рез.ошибка() тогда
			возврат быстряга.Отклик(400, ОтветПользователь(0, "", "", ложь, массив()))
		конец
		быстряга.Отклик(201, пользователь_в_ответ(соед, модель.Пользователь(ид_рез.значение(), вход.логин, "", "", вход.email, истина, ложь)))
	конец
	(нулевое_тело, обработчик)
конец

экспорт функ обработчик_список_пользователей(соед: Соединение_БД) -> функ(http.ЗапросМаршрута, Строка) -> быстряга.Отклик(ОтветПользователи)
	функ(зм: http.ЗапросМаршрута, _admin: Строка) -> быстряга.Отклик(ОтветПользователи)
		пер пользователи = модель.все_пользователи(соед).получить(массив())
		быстряга.Отклик(200, ОтветПользователи(кол.отобразить(пользователи, функ(п: модель.Пользователь) -> ОтветПользователь пользователь_в_ответ(соед, п) конец)))
	конец
конец

экспорт функ обработчик_получить_пользователя(соед: Соединение_БД) -> функ(http.ЗапросМаршрута, Строка) -> быстряга.Отклик(ОтветПользователь)
	функ(зм: http.ЗапросМаршрута, _admin: Строка) -> быстряга.Отклик(ОтветПользователь)
		пер ид_текст = зм.параметры.получить("ид", "")
		пер ид_рез = строки.в_число(ид_текст)
		если ид_рез.ошибка() тогда
			возврат быстряга.Отклик(400, ОтветПользователь(0, "", "", ложь, массив()))
		конец
		пер пользователь_рез = модель.найти_пользователя_по_ид(соед, ид_рез.значение() как Целое)
		если пользователь_рез.ошибка() тогда
			возврат быстряга.Отклик(404, ОтветПользователь(0, "", "", ложь, массив()))
		конец
		быстряга.Отклик(200, пользователь_в_ответ(соед, пользователь_рез.значение()))
	конец
конец

экспорт тип ВходОбновитьПользователя = структура
	email:   Строка
	активен: Булево
конец

реализация быстряга.ТелоJSON для ВходОбновитьПользователя
	функ заполнить_из_json(это: ВходОбновитьПользователя, значение: json.Значение) -> Опция(Ошибка)
		это.email = значение.поле("email").получить(json.Значение.Ноль).как_строку().получить("")
		это.активен = значение.поле("активен").получить(json.Значение.Ноль).как_булево().получить(истина)
		Опция.Нет()
	конец
конец

реализация быстряга.Валидируемое для ВходОбновитьПользователя
	функ проверить(это: ВходОбновитьПользователя) -> Опция(Строка)
		Опция.Нет()
	конец
конец

экспорт функ обработчик_обновить_пользователя(соед: Соединение_БД) -> (функ() -> ВходОбновитьПользователя, функ(http.ЗапросМаршрута, Строка, ВходОбновитьПользователя) -> быстряга.Отклик(ОтветПользователь))
	пер нулевое_тело = функ() -> ВходОбновитьПользователя ВходОбновитьПользователя("", истина) конец
	пер обработчик = функ(зм: http.ЗапросМаршрута, _admin: Строка, вход: ВходОбновитьПользователя) -> быстряга.Отклик(ОтветПользователь)
		пер ид_рез = строки.в_число(зм.параметры.получить("ид", ""))
		если ид_рез.ошибка() тогда
			возврат быстряга.Отклик(400, ОтветПользователь(0, "", "", ложь, массив()))
		конец
		пер ид = ид_рез.значение() как Целое
		пер обновление = модель.обновить_пользователя(соед, ид, вход.email, вход.активен)
		если обновление.ошибка() тогда
			возврат быстряга.Отклик(400, ОтветПользователь(0, "", "", ложь, массив()))
		конец
		пер пользователь_рез = модель.найти_пользователя_по_ид(соед, ид)
		если пользователь_рез.ошибка() тогда
			возврат быстряга.Отклик(404, ОтветПользователь(0, "", "", ложь, массив()))
		конец
		быстряга.Отклик(200, пользователь_в_ответ(соед, пользователь_рез.значение()))
	конец
	(нулевое_тело, обработчик)
конец

экспорт функ обработчик_удалить_пользователя(соед: Соединение_БД) -> функ(http.ЗапросМаршрута, Строка) -> быстряга.Отклик(ОтветПусто)
	функ(зм: http.ЗапросМаршрута, _admin: Строка) -> быстряга.Отклик(ОтветПусто)
		пер ид_рез = строки.в_число(зм.параметры.получить("ид", ""))
		если ид_рез.ошибка() тогда
			возврат быстряга.Отклик(400, ОтветПусто(ложь))
		конец
		быстряга.Отклик(200, ОтветПусто(не модель.удалить_пользователя(соед, ид_рез.значение() как Целое).ошибка()))
	конец
конец

// --- /api/группы ---

экспорт тип ВходГруппа = структура
	имя: Строка
конец

реализация быстряга.ТелоJSON для ВходГруппа
	функ заполнить_из_json(это: ВходГруппа, значение: json.Значение) -> Опция(Ошибка)
		это.имя = значение.поле("имя").получить(json.Значение.Ноль).как_строку().получить("")
		Опция.Нет()
	конец
конец

реализация быстряга.Валидируемое для ВходГруппа
	функ проверить(это: ВходГруппа) -> Опция(Строка)
		если длина(это.имя) == 0 тогда
			возврат Опция.Есть("имя обязательно")
		конец
		Опция.Нет()
	конец
конец

экспорт тип ОтветГруппа = структура
	ид:  Целое
	имя: Строка
конец

реализация быстряга.ОтветJSON для ОтветГруппа
	функ в_json(это: ОтветГруппа) -> json.Значение
		json.объект(массив(("ид", json.Значение.Число(это.ид как Число)), ("имя", json.Значение.Строка(это.имя))))
	конец
конец

экспорт тип ОтветГруппы = структура
	элементы: Массив(ОтветГруппа)
конец

реализация быстряга.ОтветJSON для ОтветГруппы
	функ в_json(это: ОтветГруппы) -> json.Значение
		json.Значение.Список(кол.отобразить(это.элементы, функ(г: ОтветГруппа) -> json.Значение г.в_json() конец))
	конец
конец

экспорт функ обработчик_создать_группу(соед: Соединение_БД) -> (функ() -> ВходГруппа, функ(Строка, ВходГруппа) -> быстряга.Отклик(ОтветГруппа))
	пер нулевое_тело = функ() -> ВходГруппа ВходГруппа("") конец
	пер обработчик = функ(_admin: Строка, вход: ВходГруппа) -> быстряга.Отклик(ОтветГруппа)
		пер ид_рез = модель.создать_группу(соед, вход.имя)
		если ид_рез.ошибка() тогда
			возврат быстряга.Отклик(400, ОтветГруппа(0, ""))
		конец
		быстряга.Отклик(201, ОтветГруппа(ид_рез.значение(), вход.имя))
	конец
	(нулевое_тело, обработчик)
конец

экспорт функ обработчик_список_групп(соед: Соединение_БД) -> функ(http.ЗапросМаршрута, Строка) -> быстряга.Отклик(ОтветГруппы)
	функ(зм: http.ЗапросМаршрута, _admin: Строка) -> быстряга.Отклик(ОтветГруппы)
		пер группы = модель.все_группы(соед).получить(массив())
		быстряга.Отклик(200, ОтветГруппы(кол.отобразить(группы, функ(г: модель.Группа) -> ОтветГруппа ОтветГруппа(г.ид, г.имя) конец)))
	конец
конец

экспорт функ обработчик_удалить_группу(соед: Соединение_БД) -> функ(http.ЗапросМаршрута, Строка) -> быстряга.Отклик(ОтветПусто)
	функ(зм: http.ЗапросМаршрута, _admin: Строка) -> быстряга.Отклик(ОтветПусто)
		пер ид_рез = строки.в_число(зм.параметры.получить("ид", ""))
		если ид_рез.ошибка() тогда
			возврат быстряга.Отклик(400, ОтветПусто(ложь))
		конец
		быстряга.Отклик(200, ОтветПусто(не модель.удалить_группу(соед, ид_рез.значение() как Целое).ошибка()))
	конец
конец

// Тело, не путь, несёт группа_ид — отправить_пост_с даёт extractor
// ЛИБО тело, но не путь одновременно (обработчик не получает
// ЗапросМаршрута — та же дыра, что была у отправить_пост до этой
// сессии, просто ещё не закрытая для _с-варианта); POST /api/группы/
// {ид}/участники потребовал бы её, а POST /api/участники с группа_ид в
// теле — нет, обходит гэп, не маскируя его.
экспорт тип ВходУчастник = структура
	пользователь_ид: Целое
	группа_ид:       Целое
конец

реализация быстряга.ТелоJSON для ВходУчастник
	функ заполнить_из_json(это: ВходУчастник, значение: json.Значение) -> Опция(Ошибка)
		это.пользователь_ид = значение.поле("пользователь_ид").получить(json.Значение.Ноль).как_число().получить(0.0) как Целое
		это.группа_ид = значение.поле("группа_ид").получить(json.Значение.Ноль).как_число().получить(0.0) как Целое
		Опция.Нет()
	конец
конец

реализация быстряга.Валидируемое для ВходУчастник
	функ проверить(это: ВходУчастник) -> Опция(Строка)
		Опция.Нет()
	конец
конец

экспорт тип ОтветПусто = структура
	ок: Булево
конец

реализация быстряга.ОтветJSON для ОтветПусто
	функ в_json(это: ОтветПусто) -> json.Значение
		json.объект(массив(("ок", json.Значение.Булево(это.ок))))
	конец
конец

экспорт функ обработчик_добавить_участника(соед: Соединение_БД) -> (функ() -> ВходУчастник, функ(Строка, ВходУчастник) -> быстряга.Отклик(ОтветПусто))
	пер нулевое_тело = функ() -> ВходУчастник ВходУчастник(0, 0) конец
	пер обработчик = функ(_admin: Строка, вход: ВходУчастник) -> быстряга.Отклик(ОтветПусто)
		пер добавление = модель.добавить_в_группу(соед, вход.пользователь_ид, вход.группа_ид)
		если добавление.ошибка() тогда
			возврат быстряга.Отклик(400, ОтветПусто(ложь))
		конец
		быстряга.Отклик(201, ОтветПусто(истина))
	конец
	(нулевое_тело, обработчик)
конец

// --- /api/клиенты ---

экспорт тип ВходКлиент = структура
	имя:          Строка
	redirect_uri: Строка
	scope:        Строка
конец

реализация быстряга.ТелоJSON для ВходКлиент
	функ заполнить_из_json(это: ВходКлиент, значение: json.Значение) -> Опция(Ошибка)
		это.имя = значение.поле("имя").получить(json.Значение.Ноль).как_строку().получить("")
		это.redirect_uri = значение.поле("redirect_uri").получить(json.Значение.Ноль).как_строку().получить("")
		это.scope = значение.поле("scope").получить(json.Значение.Ноль).как_строку().получить("openid")
		Опция.Нет()
	конец
конец

реализация быстряга.Валидируемое для ВходКлиент
	функ проверить(это: ВходКлиент) -> Опция(Строка)
		если длина(это.имя) == 0 тогда
			возврат Опция.Есть("имя обязательно")
		конец
		если длина(это.redirect_uri) == 0 тогда
			возврат Опция.Есть("redirect_uri обязателен")
		конец
		Опция.Нет()
	конец
конец

/// client_secret присутствует ТОЛЬКО в ЭТОМ ответе — одноразовая выдача
/// (SC-005, US2 Acceptance Scenario 3).
экспорт тип ОтветКлиентСоздан = структура
	client_id:     Строка
	client_secret: Строка
	имя:           Строка
конец

реализация быстряга.ОтветJSON для ОтветКлиентСоздан
	функ в_json(это: ОтветКлиентСоздан) -> json.Значение
		json.объект(массив(
			("client_id", json.Значение.Строка(это.client_id)),
			("client_secret", json.Значение.Строка(это.client_secret)),
			("имя", json.Значение.Строка(это.имя)),
		))
	конец
конец

экспорт тип ОтветКлиент = структура
	client_id:     Строка
	имя:           Строка
	redirect_uris: Массив(Строка)
	scopes:        Массив(Строка)
конец

реализация быстряга.ОтветJSON для ОтветКлиент
	функ в_json(это: ОтветКлиент) -> json.Значение
		json.объект(массив(
			("client_id", json.Значение.Строка(это.client_id)),
			("имя", json.Значение.Строка(это.имя)),
			("redirect_uris", json.Значение.Список(кол.отобразить(это.redirect_uris, функ(с: Строка) -> json.Значение json.Значение.Строка(с) конец))),
			("scopes", json.Значение.Список(кол.отобразить(это.scopes, функ(с: Строка) -> json.Значение json.Значение.Строка(с) конец))),
		))
	конец
конец

экспорт тип ОтветКлиенты = структура
	элементы: Массив(ОтветКлиент)
конец

реализация быстряга.ОтветJSON для ОтветКлиенты
	функ в_json(это: ОтветКлиенты) -> json.Значение
		json.Значение.Список(кол.отобразить(это.элементы, функ(к: ОтветКлиент) -> json.Значение к.в_json() конец))
	конец
конец

функ клиент_в_ответ(к: модель.Клиент) -> ОтветКлиент
	ОтветКлиент(к.client_id, к.имя, к.redirect_uris, к.scopes)
конец

экспорт функ обработчик_создать_клиента(соед: Соединение_БД) -> (функ() -> ВходКлиент, функ(Строка, ВходКлиент) -> быстряга.Отклик(ОтветКлиентСоздан))
	пер нулевое_тело = функ() -> ВходКлиент ВходКлиент("", "", "") конец
	пер обработчик = функ(_admin: Строка, вход: ВходКлиент) -> быстряга.Отклик(ОтветКлиентСоздан)
		пер client_id = "cid_" + криптография.случайные_байты_base64url(16)
		пер секрет_открытый = криптография.случайные_байты_base64url(24)
		пер хс = пароли.хэшировать(секрет_открытый)
		пер scopes = кол.отфильтровать(строки.разбить(вход.scope, " "), функ(с: Строка) -> Булево длина(с) > 0 конец)
		пер создание = модель.создать_клиента(соед, client_id, хс.хэш, хс.соль, вход.имя, массив(вход.redirect_uri), scopes)
		если создание.ошибка() тогда
			возврат быстряга.Отклик(400, ОтветКлиентСоздан("", "", ""))
		конец
		быстряга.Отклик(201, ОтветКлиентСоздан(client_id, секрет_открытый, вход.имя))
	конец
	(нулевое_тело, обработчик)
конец

экспорт функ обработчик_список_клиентов(соед: Соединение_БД) -> функ(http.ЗапросМаршрута, Строка) -> быстряга.Отклик(ОтветКлиенты)
	функ(зм: http.ЗапросМаршрута, _admin: Строка) -> быстряга.Отклик(ОтветКлиенты)
		пер клиенты = модель.все_клиенты(соед).получить(массив())
		быстряга.Отклик(200, ОтветКлиенты(кол.отобразить(клиенты, клиент_в_ответ)))
	конец
конец

экспорт функ обработчик_получить_клиента(соед: Соединение_БД) -> функ(http.ЗапросМаршрута, Строка) -> быстряга.Отклик(ОтветКлиент)
	функ(зм: http.ЗапросМаршрута, _admin: Строка) -> быстряга.Отклик(ОтветКлиент)
		пер client_id = зм.параметры.получить("client_id", "")
		пер клиент_рез = модель.найти_клиента(соед, client_id)
		если клиент_рез.ошибка() тогда
			возврат быстряга.Отклик(404, ОтветКлиент("", "", массив(), массив()))
		конец
		быстряга.Отклик(200, клиент_в_ответ(клиент_рез.значение()))
	конец
конец

экспорт тип ВходОбновитьКлиента = структура
	имя:          Строка
	redirect_uri: Строка
	scope:        Строка
конец

реализация быстряга.ТелоJSON для ВходОбновитьКлиента
	функ заполнить_из_json(это: ВходОбновитьКлиента, значение: json.Значение) -> Опция(Ошибка)
		это.имя = значение.поле("имя").получить(json.Значение.Ноль).как_строку().получить("")
		это.redirect_uri = значение.поле("redirect_uri").получить(json.Значение.Ноль).как_строку().получить("")
		это.scope = значение.поле("scope").получить(json.Значение.Ноль).как_строку().получить("openid")
		Опция.Нет()
	конец
конец

реализация быстряга.Валидируемое для ВходОбновитьКлиента
	функ проверить(это: ВходОбновитьКлиента) -> Опция(Строка)
		если длина(это.имя) == 0 тогда
			возврат Опция.Есть("имя обязательно")
		конец
		если длина(это.redirect_uri) == 0 тогда
			возврат Опция.Есть("redirect_uri обязателен")
		конец
		Опция.Нет()
	конец
конец

экспорт функ обработчик_обновить_клиента(соед: Соединение_БД) -> (функ() -> ВходОбновитьКлиента, функ(http.ЗапросМаршрута, Строка, ВходОбновитьКлиента) -> быстряга.Отклик(ОтветКлиент))
	пер нулевое_тело = функ() -> ВходОбновитьКлиента ВходОбновитьКлиента("", "", "") конец
	пер обработчик = функ(зм: http.ЗапросМаршрута, _admin: Строка, вход: ВходОбновитьКлиента) -> быстряга.Отклик(ОтветКлиент)
		пер client_id = зм.параметры.получить("client_id", "")
		пер scopes = кол.отфильтровать(строки.разбить(вход.scope, " "), функ(с: Строка) -> Булево длина(с) > 0 конец)
		пер обновление = модель.обновить_клиента(соед, client_id, вход.имя, массив(вход.redirect_uri), scopes)
		если обновление.ошибка() тогда
			возврат быстряга.Отклик(400, ОтветКлиент("", "", массив(), массив()))
		конец
		пер клиент_рез = модель.найти_клиента(соед, client_id)
		если клиент_рез.ошибка() тогда
			возврат быстряга.Отклик(404, ОтветКлиент("", "", массив(), массив()))
		конец
		быстряга.Отклик(200, клиент_в_ответ(клиент_рез.значение()))
	конец
	(нулевое_тело, обработчик)
конец

экспорт функ обработчик_удалить_клиента(соед: Соединение_БД) -> функ(http.ЗапросМаршрута, Строка) -> быстряга.Отклик(ОтветПусто)
	функ(зм: http.ЗапросМаршрута, _admin: Строка) -> быстряга.Отклик(ОтветПусто)
		пер client_id = зм.параметры.получить("client_id", "")
		быстряга.Отклик(200, ОтветПусто(не модель.удалить_клиента(соед, client_id).ошибка()))
	конец
конец
