// oauth.pns — OAuth2/OIDC Authorization Code + PKCE flow (US1) поверх
// СЫРОГО http.Маршрутизатор (не быстряга.Приложение — /authorize и
// /login/consent отдают HTML-формы и 302-редиректы, ни то ни другое не
// укладывается в JSON-типизированный слой быстряги; см. дискуссию в
// сессии про Запрос.ответить_с_заголовками).
//
// Между /authorize (GET, показывает форму логина) и /login (POST,
// проверяет креды) НЕТ сервера-side сессии/cookie — вместо этого
// oauth-параметры запроса едут как hidden-поля формы. Это безопасно,
// потому что client_id/redirect_uri/code_challenge_method
// ПЕРЕПРОВЕРЯЮТСЯ заново на входе /login (проверить_параметры), а не
// слепо доверяются присланным полям. После успешного логина sub кладётся
// в подписанный HS256 JWT ("login_ticket", TTL 5 минут, подписан
// СЕРВЕРНЫМ секретом дозорного, НЕ секретом клиента) — единственное, что
// /consent реально доверяет, все остальные детали запроса дозорный
// сам достаёт из тикета, а не из повторных hidden-полей.

импорт бд
импорт "модель.pns" как модель
импорт "пароли.pns" как пароли
импорт "сеть/http" как http
импорт "кодирование/json" как json
импорт "кодирование/jwt" как jwt
импорт криптография
импорт строки
импорт время
импорт коллекции как кол

конст TTL_КОДА_МС = 600000.0        // 10 минут (FR-005)
конст TTL_ТИКЕТА_МС = 300000.0      // 5 минут — окно логин -> согласие
конст TTL_ACCESS_МС = 3600000.0     // 1 час
конст TTL_REFRESH_МС = 2592000000.0 // 30 дней
конст TTL_ID_ТОКЕНА_С = 3600.0      // 1 час, в СЕКУНДАХ — поле exp JWT

функ экранировать_html(текст: Строка) -> Строка
	пер шаг1 = строки.заменить(текст, "&", "&amp;")
	пер шаг2 = строки.заменить(шаг1, "<", "&lt;")
	пер шаг3 = строки.заменить(шаг2, ">", "&gt;")
	строки.заменить(шаг3, "\"", "&quot;")
конец

функ hidden_поле(имя: Строка, значение: Строка) -> Строка
	"<input type=\"hidden\" name=\"" + имя + "\" value=\"" + экранировать_html(значение) + "\">\n"
конец

/// Общие oauth-параметры запроса — переносятся между /authorize,
/// /login, /consent как единое целое (hidden-поля формы либо claims
/// login_ticket).
тип ПараметрыАвторизации = структура
	client_id:            Строка
	redirect_uri:         Строка
	scope:                Строка
	state:                Строка
	code_challenge:       Строка
	code_challenge_method: Строка
конец

функ параметры_из_query(query: Соответствие(Строка, Строка)) -> ПараметрыАвторизации
	ПараметрыАвторизации(
		query.получить("client_id", ""),
		query.получить("redirect_uri", ""),
		query.получить("scope", ""),
		query.получить("state", ""),
		query.получить("code_challenge", ""),
		query.получить("code_challenge_method", ""),
	)
конец

функ параметры_в_hidden(п: ПараметрыАвторизации) -> Строка
	hidden_поле("client_id", п.client_id) +
	hidden_поле("redirect_uri", п.redirect_uri) +
	hidden_поле("scope", п.scope) +
	hidden_поле("state", п.state) +
	hidden_поле("code_challenge", п.code_challenge) +
	hidden_поле("code_challenge_method", п.code_challenge_method)
конец

/// FR-003 — client_id известен, redirect_uri входит в список клиента,
/// code_challenge_method == "S256". Возвращает Клиент при успехе —
/// вызывающий использует его дальше (имя для экрана согласия, scopes
/// для валидации и т.п.), не только факт валидности.
функ проверить_параметры(соед: Соединение_БД, п: ПараметрыАвторизации) -> Результат(модель.Клиент, Строка)
	пер клиент_рез = модель.найти_клиента(соед, п.client_id)
	если клиент_рез.ошибка() тогда
		возврат Результат.Неудача("неизвестный client_id")
	конец
	пер клиент = клиент_рез.значение()
	если не кол.любой(клиент.redirect_uris, функ(u: Строка) -> Булево u == п.redirect_uri конец) тогда
		возврат Результат.Неудача("redirect_uri не зарегистрирован для этого клиента")
	конец
	если п.code_challenge_method <> "S256" тогда
		возврат Результат.Неудача("code_challenge_method должен быть S256")
	конец
	если длина(п.code_challenge) == 0 тогда
		возврат Результат.Неудача("code_challenge обязателен")
	конец
	Результат.Успех(клиент)
конец

функ форма_логина(п: ПараметрыАвторизации, ошибка_текст: Строка) -> Строка
	пер блок_ошибки = если длина(ошибка_текст) > 0 тогда "<p style=\"color:red\">" + экранировать_html(ошибка_текст) + "</p>" иначе "" конец
	"<!DOCTYPE html><html><body><h1>Вход</h1>" + блок_ошибки +
	"<form method=\"POST\" action=\"/login\">" +
	параметры_в_hidden(п) +
	"<label>Логин: <input type=\"text\" name=\"логин\"></label><br>" +
	"<label>Пароль: <input type=\"password\" name=\"пароль\"></label><br>" +
	"<button type=\"submit\">Войти</button>" +
	"</form></body></html>"
конец

функ форма_согласия(п: ПараметрыАвторизации, имя_клиента: Строка, login_ticket: Строка) -> Строка
	"<!DOCTYPE html><html><body><h1>Запрос доступа</h1>" +
	"<p>Приложение <b>" + экранировать_html(имя_клиента) + "</b> запрашивает доступ к: " + экранировать_html(п.scope) + "</p>" +
	"<form method=\"POST\" action=\"/consent\">" +
	hidden_поле("login_ticket", login_ticket) +
	"<button type=\"submit\" name=\"decision\" value=\"allow\">Разрешить</button>" +
	"<button type=\"submit\" name=\"decision\" value=\"deny\">Отклонить</button>" +
	"</form></body></html>"
конец

/// GET /authorize — FR-003. Отклоняет ДО показа формы логина при
/// невалидных параметрах (400), иначе — форма логина (Acceptance
/// Scenario 1).
экспорт функ обработать_authorize(соед: Соединение_БД, зм: http.ЗапросМаршрута) -> http.ОтветСервера
	пер response_type = зм.query.получить("response_type", "")
	если response_type <> "code" тогда
		возврат http.ответ(400, "text/plain", "response_type должен быть 'code'")
	конец
	пер п = параметры_из_query(зм.query)
	пер проверка = проверить_параметры(соед, п)
	если проверка.ошибка() тогда
		возврат http.ответ(400, "text/plain", проверка.причина())
	конец
	http.ответ(200, "text/html", форма_логина(п, ""))
конец

/// POST /login — проверяет креды, при успехе показывает экран согласия
/// (Acceptance Scenario 2, 3), при провале — форму логина заново с
/// ошибкой, БЕЗ создания какой-либо сессии (Acceptance Scenario 2).
экспорт функ обработать_login(соед: Соединение_БД, секрет_сервера: Строка, зм: http.ЗапросМаршрута) -> http.ОтветСервера
	пер поля = http.разобрать_query(зм.запрос.тело())
	пер п = параметры_из_query(поля)
	пер проверка = проверить_параметры(соед, п)
	если проверка.ошибка() тогда
		возврат http.ответ(400, "text/plain", проверка.причина())
	конец
	пер клиент = проверка.значение()

	пер логин = поля.получить("логин", "")
	пер пароль = поля.получить("пароль", "")
	пер пользователь_рез = модель.найти_пользователя_по_логину(соед, логин)
	если пользователь_рез.ошибка() тогда
		возврат http.ответ(200, "text/html", форма_логина(п, "неверный логин или пароль"))
	конец
	пер пользователь = пользователь_рез.значение()
	если не пользователь.активен или не пароли.проверить(пароль, пользователь.хэш_пароля, пользователь.соль) тогда
		возврат http.ответ(200, "text/html", форма_логина(п, "неверный логин или пароль"))
	конец

	// Упрощённый flow-движок (v1) — единственная стадия, которую админ
	// сегодня может выключить: consent. Выключена -> код выдаётся сразу
	// после успешного пароля, экран согласия целиком пропускается (тот
	// же путь, что обработать_consent брал бы при decision=allow).
	пер consent_включена = модель.стадия_включена(соед, "consent").получить(истина)
	если не consent_включена тогда
		возврат выдать_код_и_редирект(соед, п.client_id, п.redirect_uri, п.scope, п.code_challenge, строки.из_целого(пользователь.ид), п.state)
	конец

	пер истечение_с = (время.сейчас_мс() / 1000.0) + (TTL_ТИКЕТА_МС / 1000.0)
	пер нагрузка = json.объект(массив(
		("sub", json.Значение.Строка(строки.из_целого(пользователь.ид))),
		("client_id", json.Значение.Строка(п.client_id)),
		("redirect_uri", json.Значение.Строка(п.redirect_uri)),
		("scope", json.Значение.Строка(п.scope)),
		("state", json.Значение.Строка(п.state)),
		("code_challenge", json.Значение.Строка(п.code_challenge)),
		("exp", json.Значение.Число(истечение_с)),
	))
	пер тикет = jwt.создать(секрет_сервера, нагрузка)
	http.ответ(200, "text/html", форма_согласия(п, клиент.имя, тикет))
конец

/// POST /consent — Acceptance Scenario 4 (отказ -> error=access_denied
/// без code) и 5 (согласие -> code одноразовый с TTL, FR-005).
экспорт функ обработать_consent(соед: Соединение_БД, секрет_сервера: Строка, зм: http.ЗапросМаршрута) -> http.ОтветСервера
	пер поля = http.разобрать_query(зм.запрос.тело())
	пер тикет = поля.получить("login_ticket", "")
	пер claims_рез = jwt.проверить(секрет_сервера, тикет)
	если claims_рез.ошибка() тогда
		возврат http.ответ(400, "text/plain", "недействительный или истёкший login_ticket")
	конец
	пер claims = claims_рез.значение()
	пер получить_строку = функ(поле: Строка) -> Строка
		claims.поле(поле).получить(json.Значение.Ноль).как_строку().получить("")
	конец
	пер sub = получить_строку("sub")
	пер redirect_uri = получить_строку("redirect_uri")
	пер state = получить_строку("state")

	если поля.получить("decision", "") <> "allow" тогда
		пер параметры_ошибки: Соответствие(Строка, Строка) = соответствие()
		параметры_ошибки["error"] = "access_denied"
		если длина(state) > 0 тогда
			параметры_ошибки["state"] = state
		конец
		возврат http.ответ_редирект(redirect_uri + http.построить_query(параметры_ошибки))
	конец

	выдать_код_и_редирект(соед, получить_строку("client_id"), redirect_uri, получить_строку("scope"), получить_строку("code_challenge"), sub, state)
конец

/// Общий хвост успешного логина (US1 Acceptance 5) — вызывается либо
/// из обработать_consent (decision=allow), либо напрямую из
/// обработать_login, когда стадия consent выключена (см. движок стадий
/// в модель.pns).
функ выдать_код_и_редирект(соед: Соединение_БД, client_id: Строка, redirect_uri: Строка, scope: Строка, code_challenge: Строка, sub: Строка, state: Строка) -> http.ОтветСервера
	пер код = криптография.случайные_байты_base64url(32)
	пер истекает_мс = (время.сейчас_мс() как Целое) + (TTL_КОДА_МС как Целое)
	пер запись_кода = модель.КодАвторизации(код, client_id, redirect_uri, scope, code_challenge, sub, истекает_мс, ложь)
	пер сохранение = модель.сохранить_код(соед, запись_кода)
	если сохранение.ошибка() тогда
		возврат http.ответ(500, "text/plain", "не удалось сохранить код авторизации")
	конец

	пер параметры_успеха: Соответствие(Строка, Строка) = соответствие()
	параметры_успеха["code"] = код
	если длина(state) > 0 тогда
		параметры_успеха["state"] = state
	конец
	http.ответ_редирект(redirect_uri + http.построить_query(параметры_успеха))
конец

функ ответ_ошибки_oauth(статус: Целое, код_ошибки: Строка, описание: Строка) -> http.ОтветСервера
	пер тело = json.объект(массив(
		("error", json.Значение.Строка(код_ошибки)),
		("error_description", json.Значение.Строка(описание)),
	))
	http.ответ(статус, "application/json", json.сериализовать(тело))
конец

/// Строит id_token для КОНФИДЕНЦИАЛЬНОГО клиента — HS256 JWT, подписан
/// ПЕРЕДАННЫМ (уже проверенным) client_secret клиента (FR-007 —
/// симметрично: тот же секрет, которым клиент аутентифицируется на
/// /token). email/profile claims — только если scope их запрашивал
/// (строки.содержит по словам, не подстрокой — "openidx" не должен
/// матчить "openid").
функ построить_id_token(базовый_url: Строка, client_secret: Строка, sub: Строка, client_id: Строка, scope: Строка, соед: Соединение_БД) -> Строка
	jwt.создать(client_secret, claims_id_token(базовый_url, sub, client_id, scope, соед))
конец

/// Строит id_token для ПУБЛИЧНОГО клиента (`Клиент.публичный`) — ES256
/// JWT, подписан СЕРВЕРНЫМ ключом (`модель.получить_или_создать_ключи_сервера`),
/// а не секретом клиента (у публичного клиента его нет). Проверяется
/// клиентом через `/.well-known/jwks.json`.
функ построить_id_token_es256(базовый_url: Строка, sub: Строка, client_id: Строка, scope: Строка, соед: Соединение_БД) -> Результат(Строка, Строка)
	пер ключи_рез = модель.получить_или_создать_ключи_сервера(соед)
	если ключи_рез.ошибка() тогда
		возврат Результат.Неудача("не удалось получить ключ сервера")
	конец
	пер ключи = ключи_рез.значение()
	Результат.Успех(jwt.создать_es256(ключи.0, claims_id_token(базовый_url, sub, client_id, scope, соед)))
конец

функ claims_id_token(базовый_url: Строка, sub: Строка, client_id: Строка, scope: Строка, соед: Соединение_БД) -> json.Значение
	пер сейчас_с = время.сейчас_мс() / 1000.0
	пер поля_массив: Массив((Строка, json.Значение)) = массив(
		("iss", json.Значение.Строка(базовый_url)),
		("sub", json.Значение.Строка(sub)),
		("aud", json.Значение.Строка(client_id)),
		("exp", json.Значение.Число(сейчас_с + TTL_ID_ТОКЕНА_С)),
		("iat", json.Значение.Число(сейчас_с)),
	)
	пер запрошены_слова = строки.разбить(scope, " ")
	если кол.любой(запрошены_слова, функ(s: Строка) -> Булево s == "email" или s == "profile" конец) тогда
		пер sub_целое_рез = строки.в_число(sub)
		если не sub_целое_рез.ошибка() тогда
			пер пользователь_рез = модель.найти_пользователя_по_ид(соед, sub_целое_рез.значение() как Целое)
			если не пользователь_рез.ошибка() тогда
				поля_массив.добавить(("email", json.Значение.Строка(пользователь_рез.значение().email)))
			конец
		конец
	конец
	json.объект(поля_массив)
конец

тип ОтветТокена = структура
	id_token:      Строка
	access_token:  Строка
	refresh_token: Строка
	expires_in:    Целое
конец

функ сериализовать_ответ_токена(о: ОтветТокена) -> Строка
	json.сериализовать(json.объект(массив(
		("id_token", json.Значение.Строка(о.id_token)),
		("access_token", json.Значение.Строка(о.access_token)),
		("refresh_token", json.Значение.Строка(о.refresh_token)),
		("token_type", json.Значение.Строка("Bearer")),
		("expires_in", json.Значение.Число(о.expires_in как Число)),
	)))
конец

/// Выдаёт access+refresh-токены (новая цепочка ротации) — общий хвост
/// для обоих grant_type (authorization_code выдаёт ПЕРВЫЙ токен цепочки,
/// refresh_token — следующее звено ТОЙ ЖЕ цепочки). id_token подписан
/// HS256 (client_secret) для конфиденциальных клиентов и ES256
/// (серверный ключ) для публичных — `клиент.публичный`.
функ выдать_токены(соед: Соединение_БД, базовый_url: Строка, клиент: модель.Клиент, client_secret: Строка, sub: Строка, scope: Строка, цепочка: Строка) -> Результат(ОтветТокена, Строка)
	пер сейчас_мс = время.сейчас_мс() как Целое
	пер access_token = криптография.случайные_байты_base64url(32)
	пер refresh_token = криптография.случайные_байты_base64url(32)
	пер client_id = клиент.client_id

	пер сохр_access = модель.сохранить_access_токен(соед, модель.AccessТокен(access_token, client_id, sub, scope, сейчас_мс + (TTL_ACCESS_МС как Целое)))
	если сохр_access.ошибка() тогда
		возврат Результат.Неудача("не удалось сохранить access-токен")
	конец
	пер сохр_refresh = модель.сохранить_refresh_токен(соед, модель.RefreshТокен(refresh_token, цепочка, client_id, sub, scope, сейчас_мс + (TTL_REFRESH_МС как Целое), ложь))
	если сохр_refresh.ошибка() тогда
		возврат Результат.Неудача("не удалось сохранить refresh-токен")
	конец

	пер id_token: Строка = ""
	если клиент.публичный тогда
		пер рез = построить_id_token_es256(базовый_url, sub, client_id, scope, соед)
		если рез.ошибка() тогда
			возврат Результат.Неудача(рез.причина())
		конец
		id_token = рез.значение()
	иначе
		id_token = построить_id_token(базовый_url, client_secret, sub, client_id, scope, соед)
	конец

	Результат.Успех(ОтветТокена(
		id_token,
		access_token,
		refresh_token,
		(TTL_ACCESS_МС / 1000.0) как Целое, // expires_in — СЕКУНДЫ (RFC 6749 §5.1), не мс
	))
конец

/// POST /token, grant_type=authorization_code — FR-006. Ошибки RFC 6749
/// §5.2 — всегда 400 {"error":"invalid_grant"} (или invalid_client),
/// без утечки, ЧТО именно не совпало (Acceptance Scenario 5, 6).
функ обработать_код_авторизации(соед: Соединение_БД, базовый_url: Строка, поля: Соответствие(Строка, Строка)) -> http.ОтветСервера
	пер client_id = поля.получить("client_id", "")
	пер client_secret = поля.получить("client_secret", "")
	пер клиент_рез = модель.найти_клиента(соед, client_id)
	если клиент_рез.ошибка() тогда
		возврат ответ_ошибки_oauth(401, "invalid_client", "неизвестный клиент")
	конец
	пер клиент = клиент_рез.значение()
	// Публичный клиент (RFC 6749 §2.1) не имеет client_secret — его
	// аутентификация на /token ЦЕЛИКОМ полагается на PKCE
	// (code_verifier ниже), не на секрет.
	если не клиент.публичный и не пароли.проверить(client_secret, клиент.хэш_secret, клиент.соль) тогда
		возврат ответ_ошибки_oauth(401, "invalid_client", "неверный client_secret")
	конец

	пер код_текст = поля.получить("code", "")
	пер код_рез = модель.найти_код(соед, код_текст)
	если код_рез.ошибка() тогда
		возврат ответ_ошибки_oauth(400, "invalid_grant", "код не найден")
	конец
	пер код = код_рез.значение()
	если код.использован тогда
		возврат ответ_ошибки_oauth(400, "invalid_grant", "код уже использован")
	конец
	если (время.сейчас_мс() как Целое) > код.истекает_мс тогда
		возврат ответ_ошибки_oauth(400, "invalid_grant", "код истёк")
	конец
	если код.client_id <> client_id тогда
		возврат ответ_ошибки_oauth(400, "invalid_grant", "код выдан другому клиенту")
	конец
	если код.redirect_uri <> поля.получить("redirect_uri", "") тогда
		возврат ответ_ошибки_oauth(400, "invalid_grant", "redirect_uri не совпадает")
	конец

	пер code_verifier = поля.получить("code_verifier", "")
	пер пересчитанный_challenge = криптография.sha256_base64url(code_verifier)
	если не криптография.сравнить_константное_время(пересчитанный_challenge, код.code_challenge) тогда
		возврат ответ_ошибки_oauth(400, "invalid_grant", "code_verifier не соответствует code_challenge")
	конец

	пер пометка = модель.пометить_код_использованным(соед, код_текст)
	если пометка.ошибка() тогда
		возврат ответ_ошибки_oauth(500, "server_error", "не удалось пометить код")
	конец

	пер цепочка = криптография.случайные_байты_base64url(16)
	пер токены = выдать_токены(соед, базовый_url, клиент, client_secret, код.sub, код.scope, цепочка)
	если токены.ошибка() тогда
		возврат ответ_ошибки_oauth(500, "server_error", токены.причина())
	конец
	http.ответ(200, "application/json", сериализовать_ответ_токена(токены.значение()))
конец

/// POST /token, grant_type=refresh_token — FR-009/US3. Повторное
/// использование УЖЕ обменянного refresh-токена инвалидирует ВСЮ
/// цепочку (Acceptance Scenario 2 — защита от кражи).
функ обработать_refresh(соед: Соединение_БД, базовый_url: Строка, поля: Соответствие(Строка, Строка)) -> http.ОтветСервера
	пер client_id = поля.получить("client_id", "")
	пер client_secret = поля.получить("client_secret", "")
	пер клиент_рез = модель.найти_клиента(соед, client_id)
	если клиент_рез.ошибка() тогда
		возврат ответ_ошибки_oauth(401, "invalid_client", "неизвестный клиент")
	конец
	пер клиент = клиент_рез.значение()
	если не клиент.публичный и не пароли.проверить(client_secret, клиент.хэш_secret, клиент.соль) тогда
		возврат ответ_ошибки_oauth(401, "invalid_client", "неверный client_secret")
	конец

	пер токен_текст = поля.получить("refresh_token", "")
	пер токен_рез = модель.найти_refresh_токен(соед, токен_текст)
	если токен_рез.ошибка() тогда
		возврат ответ_ошибки_oauth(400, "invalid_grant", "refresh-токен не найден")
	конец
	пер токен = токен_рез.значение()
	если токен.использован тогда
		модель.инвалидировать_цепочку(соед, токен.цепочка)
		возврат ответ_ошибки_oauth(400, "invalid_grant", "refresh-токен уже использован — цепочка отозвана")
	конец
	если (время.сейчас_мс() как Целое) > токен.истекает_мс тогда
		возврат ответ_ошибки_oauth(400, "invalid_grant", "refresh-токен истёк")
	конец
	если токен.client_id <> client_id тогда
		возврат ответ_ошибки_oauth(400, "invalid_grant", "refresh-токен выдан другому клиенту")
	конец

	пер пометка = модель.пометить_refresh_использованным(соед, токен_текст)
	если пометка.ошибка() тогда
		возврат ответ_ошибки_oauth(500, "server_error", "не удалось пометить refresh-токен")
	конец

	пер новые_токены = выдать_токены(соед, базовый_url, клиент, client_secret, токен.sub, токен.scope, токен.цепочка)
	если новые_токены.ошибка() тогда
		возврат ответ_ошибки_oauth(500, "server_error", новые_токены.причина())
	конец
	http.ответ(200, "application/json", сериализовать_ответ_токена(новые_токены.значение()))
конец

/// POST /token — диспетчер по grant_type. Тело form-urlencoded (RFC
/// 6749 §4.1.3), НЕ JSON — единственный такой endpoint в дозорном,
/// поэтому идёт через сырой Маршрутизатор, а не быстряга.Приложение
/// (которое разбирает тело только как JSON).
экспорт функ обработать_token(соед: Соединение_БД, базовый_url: Строка, зм: http.ЗапросМаршрута) -> http.ОтветСервера
	пер поля = http.разобрать_query(зм.запрос.тело())
	пер grant_type = поля.получить("grant_type", "")
	выбор grant_type
		"authorization_code" -> обработать_код_авторизации(соед, базовый_url, поля)
		"refresh_token" -> обработать_refresh(соед, базовый_url, поля)
		_ -> ответ_ошибки_oauth(400, "unsupported_grant_type", "grant_type должен быть authorization_code или refresh_token")
	конец
конец

/// GET /userinfo (Bearer access_token) — FR-008.
экспорт функ обработать_userinfo(соед: Соединение_БД, зм: http.ЗапросМаршрута) -> http.ОтветСервера
	пер заголовок = зм.запрос.заголовок("Authorization").получить("")
	если не строки.начинается_с(заголовок, "Bearer ") тогда
		возврат http.ответ(401, "application/json", json.сериализовать(json.объект(массив(("error", json.Значение.Строка("invalid_token"))))))
	конец
	пер токен_текст = строки.срез(заголовок, 7, длина(заголовок))
	пер токен_рез = модель.найти_access_токен(соед, токен_текст)
	если токен_рез.ошибка() тогда
		возврат http.ответ(401, "application/json", json.сериализовать(json.объект(массив(("error", json.Значение.Строка("invalid_token"))))))
	конец
	пер токен = токен_рез.значение()
	если (время.сейчас_мс() как Целое) > токен.истекает_мс тогда
		возврат http.ответ(401, "application/json", json.сериализовать(json.объект(массив(("error", json.Значение.Строка("invalid_token"))))))
	конец

	пер поля_ответа: Массив((Строка, json.Значение)) = массив(("sub", json.Значение.Строка(токен.sub)))
	пер запрошены_слова = строки.разбить(токен.scope, " ")
	если кол.любой(запрошены_слова, функ(s: Строка) -> Булево s == "email" или s == "profile" конец) тогда
		пер sub_целое_рез = строки.в_число(токен.sub)
		если не sub_целое_рез.ошибка() тогда
			пер пользователь_рез = модель.найти_пользователя_по_ид(соед, sub_целое_рез.значение() как Целое)
			если не пользователь_рез.ошибка() тогда
				поля_ответа.добавить(("email", json.Значение.Строка(пользователь_рез.значение().email)))
			конец
		конец
	конец
	http.ответ(200, "application/json", json.сериализовать(json.объект(поля_ответа)))
конец

/// GET /.well-known/openid-configuration — FR-012.
экспорт функ обработать_discovery(базовый_url: Строка, зм: http.ЗапросМаршрута) -> http.ОтветСервера
	пер тело = json.объект(массив(
		("issuer", json.Значение.Строка(базовый_url)),
		("authorization_endpoint", json.Значение.Строка(базовый_url + "/authorize")),
		("token_endpoint", json.Значение.Строка(базовый_url + "/token")),
		("userinfo_endpoint", json.Значение.Строка(базовый_url + "/userinfo")),
		("jwks_uri", json.Значение.Строка(базовый_url + "/.well-known/jwks.json")),
	))
	http.ответ(200, "application/json", json.сериализовать(тело))
конец

/// GET /.well-known/jwks.json (RFC 7517) — публичный ключ сервера для
/// проверки ES256 id_token публичных клиентов (`Клиент.публичный`).
/// x/y уже base64url — ТОТ ЖЕ формат, что требует JWK "x"/"y" (RFC
/// 7518 §6.2.1.2/6.2.1.3), кодировать заново не нужно. `kid` фиксирован
/// ("1") — сервер держит РОВНО один ES256-ключ (см.
/// модель.получить_или_создать_ключи_сервера), ротации ключей нет в v1.
экспорт функ обработать_jwks(соед: Соединение_БД, зм: http.ЗапросМаршрута) -> http.ОтветСервера
	пер ключи_рез = модель.получить_или_создать_ключи_сервера(соед)
	если ключи_рез.ошибка() тогда
		возврат http.ответ(500, "application/json", json.сериализовать(json.объект(массив(("error", json.Значение.Строка("server_error"))))))
	конец
	пер ключи = ключи_рез.значение()
	пер jwk = json.объект(массив(
		("kty", json.Значение.Строка("EC")),
		("crv", json.Значение.Строка("P-256")),
		("x", json.Значение.Строка(ключи.1)),
		("y", json.Значение.Строка(ключи.2)),
		("use", json.Значение.Строка("sig")),
		("alg", json.Значение.Строка("ES256")),
		("kid", json.Значение.Строка("1")),
	))
	пер тело = json.объект(массив(("keys", json.Значение.Список(массив(jwk)))))
	http.ответ(200, "application/json", json.сериализовать(тело))
конец
